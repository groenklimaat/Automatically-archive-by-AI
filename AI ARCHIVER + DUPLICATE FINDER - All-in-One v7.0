# ============================================================================
# DOCUMENTTYPES & MAPPENSTRUCTUUR
# ============================================================================

class DocumentType(Enum):
    OFFERTE = "offerte"
    FACTUUR = "factuur"
    CREDITNOTA = "creditnota"
    VERKOOPSVOORWAARDEN = "verkoopsvoorwaarden"
    WARMTEPOMP_ONDERHOUD = "warmtepomp_onderhoud"
    WARMTEPOMP_LEKTEST = "warmtepomp_lektest"
    WARMTEPOMP_INSTALLATIE = "warmtepomp_installatie"
    HYDRAULISCH_GROOTONDERHOUD = "hydraulisch_grootonderhoud"
    HYDRAULISCH_REGELING = "hydraulisch_regeling"
    REINIGINGSATTEST_GAS = "reinigingsattest_gas"
    REINIGINGSATTEST_VLOEIBARE = "reinigingsattest_vloeibare"
    VERBRANDINGSATTEST = "verbrandingsattest"
    ONDERHOUDSCONTRACT = "onderhoudscontract"
    KLANTENLISTING = "klantenlisting"
    TECHNISCHE_FICHE = "technische_fiche"
    GARANTIEBEWIJS = "garantiebewijs"
    LEVERINGSBON = "leveringsbon"
    STOOKOLIE_BESTELLING = "stookolie_bestelling"
    AFKEURINGSRAPPORT = "afkeuringsrapport"
    KEURINGSRAPPORT = "keuringsrapport"

    def get_map_naam(self) -> str:
        mapping = {
            DocumentType.OFFERTE: "Offertes",
            DocumentType.FACTUUR: "Facturen",
            DocumentType.CREDITNOTA: "Creditnotas",
            DocumentType.VERKOOPSVOORWAARDEN: "Algemeen/Verkoopsvoorwaarden",
            DocumentType.WARMTEPOMP_ONDERHOUD: "Warmtepompen/Onderhoud",
            DocumentType.WARMTEPOMP_LEKTEST: "Warmtepompen/Lektesten",
            DocumentType.WARMTEPOMP_INSTALLATIE: "Warmtepompen/Installaties",
            DocumentType.HYDRAULISCH_GROOTONDERHOUD: "Hydraulica/Groot onderhoud",
            DocumentType.HYDRAULISCH_REGELING: "Hydraulica/Regelingen",
            DocumentType.REINIGINGSATTEST_GAS: "Attesten/Reiniging gasvormig",
            DocumentType.REINIGINGSATTEST_VLOEIBARE: "Attesten/Reiniging vloeibare brandstof",
            DocumentType.VERBRANDINGSATTEST: "Attesten/Verbranding",
            DocumentType.ONDERHOUDSCONTRACT: "Contracten/Onderhoud",
            DocumentType.KLANTENLISTING: "Klanten/Overzichten",
            DocumentType.TECHNISCHE_FICHE: "Technische fiches",
            DocumentType.GARANTIEBEWIJS: "Garanties",
            DocumentType.LEVERINGSBON: "Leveringsbonnen",
            DocumentType.STOOKOLIE_BESTELLING: "Stookolie/Bestellingen",
            DocumentType.AFKEURINGSRAPPORT: "Rapporten/Afkeuringen",
            DocumentType.KEURINGSRAPPORT: "Rapporten/Keuringen",
        }
        return mapping.get(self, "Overig")


@dataclass
class DocumentInfo:
    bestandspad: Path
    document_type: DocumentType
    klant_naam: Optional[str] = None
    volgnummer: Optional[str] = None
    datum: Optional[datetime] = None
    confidence: float = 0.0


@dataclass
class ScanResult:
    pad: Path
    niveau: int
    bestanden: List[Path]
    mappen: List[Path]
    geselecteerd: bool = False


# ============================================================================
# SCHIJF DETECTOR
# ============================================================================

class DriveDetector:
    """Detecteert alle beschikbare schijven op het systeem"""
    
    @staticmethod
    def get_all_drives() -> List[Dict]:
        """Geeft een lijst van alle beschikbare schijven"""
        drives = []
        
        if sys.platform == "win32":
            # Windows: alle schijven van A: tot Z:
            import string
            from ctypes import windll
            
            for letter in string.ascii_uppercase:
                drive_path = f"{letter}:\\"
                if os.path.exists(drive_path):
                    try:
                        # Bepaal schijftype
                        drive_type = windll.kernel32.GetDriveTypeW(drive_path)
                        type_names = {
                            0: "Onbekend",
                            1: "Bestaat niet",
                            2: "Verwisselbaar",
                            3: "Vaste schijf",
                            4: "Netwerk",
                            5: "CD-ROM",
                            6: "RAM-schijf"
                        }
                        
                        # Bereken vrije ruimte
                        try:
                            usage = shutil.disk_usage(drive_path)
                            free_gb = usage.free / (1024**3)
                            total_gb = usage.total / (1024**3)
                            space_info = f"{free_gb:.1f} GB vrij / {total_gb:.1f} GB totaal"
                        except:
                            space_info = "Onbekende ruimte"
                        
                        drives.append({
                            'path': drive_path,
                            'letter': letter,
                            'type': type_names.get(drive_type, "Onbekend"),
                            'space': space_info,
                            'is_drive': True
                        })
                    except:
                        pass
        else:
            # Linux/Mac: /mnt, /media, etc.
            for path in ['/mnt', '/media', '/']:
                if os.path.exists(path):
                    for item in os.listdir(path):
                        full_path = os.path.join(path, item)
                        if os.path.ismount(full_path):
                            try:
                                usage = shutil.disk_usage(full_path)
                                free_gb = usage.free / (1024**3)
                                total_gb = usage.total / (1024**3)
                                drives.append({
                                    'path': full_path,
                                    'letter': item,
                                    'type': "Mount point",
                                    'space': f"{free_gb:.1f} GB vrij / {total_gb:.1f} GB totaal",
                                    'is_drive': True
                                })
                            except:
                                pass
        
        return drives


# ============================================================================
# SORTEERMOTOR
# ============================================================================

class HVACSorteerder:
    def __init__(self, target_base: Path):
        self.target_base = Path(target_base)
        self.classifier = None
        self.volgnummers_file = self.target_base / "volgnummers.json"
        self.volgnummers = self._laad_volgnummers()
        self.trefwoorden = {
            "offerte": DocumentType.OFFERTE, "off": DocumentType.OFFERTE,
            "factuur": DocumentType.FACTUUR, "fact": DocumentType.FACTUUR,
            "creditnota": DocumentType.CREDITNOTA, "credit": DocumentType.CREDITNOTA,
            "verkoopsvoorwaarde": DocumentType.VERKOOPSVOORWAARDEN, "terms": DocumentType.VERKOOPSVOORWAARDEN,
            "warmtepomp": DocumentType.WARMTEPOMP_ONDERHOUD,
            "lektest": DocumentType.WARMTEPOMP_LEKTEST,
            "installatie": DocumentType.WARMTEPOMP_INSTALLATIE,
            "hydraulisch": DocumentType.HYDRAULISCH_GROOTONDERHOUD,
            "regeling": DocumentType.HYDRAULISCH_REGELING,
            "reinigingsattest": DocumentType.REINIGINGSATTEST_GAS,
            "verbrandingsattest": DocumentType.VERBRANDINGSATTEST,
            "onderhoudscontract": DocumentType.ONDERHOUDSCONTRACT,
            "garantie": DocumentType.GARANTIEBEWIJS,
            "leveringsbon": DocumentType.LEVERINGSBON,
            "stookolie": DocumentType.STOOKOLIE_BESTELLING,
        }

    def _laad_volgnummers(self) -> Dict:
        if self.volgnummers_file.exists():
            with open(self.volgnummers_file, 'r') as f:
                return json.load(f)
        return {}

    def _bewaar_volgnummers(self):
        self.volgnummers_file.parent.mkdir(parents=True, exist_ok=True)
        with open(self.volgnummers_file, 'w') as f:
            json.dump(self.volgnummers, f, indent=2)

    def genereer_volgnummer(self, doc_type: DocumentType, jaar: int = None) -> str:
        if jaar is None:
            jaar = datetime.now().year
        key = f"{doc_type.value}_{jaar}"
        self.volgnummers[key] = self.volgnummers.get(key, 0) + 1
        self._bewaar_volgnummers()
        prefix = {DocumentType.OFFERTE: "OFF", DocumentType.FACTUUR: "FACT", DocumentType.CREDITNOTA: "CRED"}.get(doc_type, doc_type.value[:4].upper())
        return f"{prefix}-{jaar}-{self.volgnummers[key]:03d}"

    def herken_documenttype_op_naam(self, bestandsnaam: str) -> Optional[DocumentType]:
        naam_lower = bestandsnaam.lower()
        for trefwoord, doc_type in self.trefwoorden.items():
            if trefwoord in naam_lower:
                return doc_type
        return None

    def herken_documenttype_met_ai(self, bestandsnaam: str) -> Tuple[Optional[DocumentType], float]:
        if not self.classifier or not AI_AVAILABLE:
            return None, 0.0
        try:
            result = self.classifier(bestandsnaam, [dt.value for dt in DocumentType])
            beste_label = result['labels'][0]
            score = result['scores'][0]
            for dt in DocumentType:
                if dt.value == beste_label:
                    return dt, score
        except Exception:
            pass
        return None, 0.0

    def _extraheer_klantnaam(self, bestandsnaam: str) -> Optional[str]:
        patronen = [
            r'klant[_\s]*([A-Z][a-z]+(?:_[A-Z][a-z]+)?)',
            r'voor\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)?)',
            r'(\w+)_(?:offerte|factuur|onderhoud)',
            r'(\w+)_\d{4}',
        ]
        for patroon in patronen:
            match = re.search(patroon, bestandsnaam, re.IGNORECASE)
            if match:
                return match.group(1).replace('_', ' ')
        return None

    def bepaal_doelpad(self, doc_info: DocumentInfo) -> Path:
        base = self.target_base / doc_info.document_type.get_map_naam()
        if doc_info.klant_naam:
            klant_clean = re.sub(r'[<>:"/\\|?*]', '_', doc_info.klant_naam.strip())
            base = base / klant_clean
        jaar = doc_info.datum.year if doc_info.datum else datetime.now().year
        base = base / str(jaar)
        if doc_info.volgnummer:
            nieuwe_naam = f"{doc_info.volgnummer}_{doc_info.bestandspad.name}"
        else:
            nieuwe_naam = doc_info.bestandspad.name
        return base / nieuwe_naam

    def sorteer_bestand(self, bestandspad: Path, log_callback=None) -> bool:
        try:
            if not bestandspad.is_file():
                return False
            doc_type = self.herken_documenttype_op_naam(bestandspad.name)
            confidence = 0.0
            if not doc_type and self.classifier:
                doc_type, confidence = self.herken_documenttype_met_ai(bestandspad.name)
            if not doc_type:
                if log_callback:
                    log_callback(f"⚠️ Onbekend type: {bestandspad.name}")
                return False
            volgnummer = None
            if doc_type in [DocumentType.OFFERTE, DocumentType.FACTUUR, DocumentType.CREDITNOTA]:
                volgnummer = self.genereer_volgnummer(doc_type)
            doc_info = DocumentInfo(
                bestandspad=bestandspad,
                document_type=doc_type,
                klant_naam=self._extraheer_klantnaam(bestandspad.name),
                volgnummer=volgnummer,
                datum=datetime.now(),
                confidence=confidence
            )
            doelpad = self.bepaal_doelpad(doc_info)
            doelpad.parent.mkdir(parents=True, exist_ok=True)
            if doelpad.exists():
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                doelpad = doelpad.parent / f"{doelpad.stem}_{timestamp}{doelpad.suffix}"
            shutil.move(str(bestandspad), str(doelpad))
            if log_callback:
                conf_str = f" (AI: {confidence:.0%})" if confidence > 0 else ""
                volg_str = f" [{volgnummer}]" if volgnummer else ""
                log_callback(f"✅ {bestandspad.name}{volg_str} → {doc_info.document_type.get_map_naam()}{conf_str}")
            return True
        except Exception as e:
            if log_callback:
                log_callback(f"❌ Fout: {bestandspad.name} - {str(e)}")
            return False

    def laad_ai_model(self, model_naam: str = "facebook/bart-large-mnli") -> bool:
        if not AI_AVAILABLE:
            return False
        try:
            self.classifier = pipeline("zero-shot-classification", model=model_naam)
            return True
        except Exception:
            return False


# ============================================================================
# SUBMAP SCANNER MET WERKENDE SELECTIE
# ============================================================================

class SubmapScanner:
    def __init__(self, max_diepte: int = 4):
        self.max_diepte = max_diepte
        self.scan_results: List[ScanResult] = []
    
    def scan_map(self, pad: Path, huidige_diepte: int = 0) -> List[ScanResult]:
        results = []
        if huidige_diepte > self.max_diepte:
            return results
        try:
            if not pad.exists() or not pad.is_dir():
                return results
            bestanden = [f for f in pad.iterdir() if f.is_file()]
            mappen = [d for d in pad.iterdir() if d.is_dir()]
            result = ScanResult(pad=pad, niveau=huidige_diepte, bestanden=bestanden, mappen=mappen, geselecteerd=False)
            results.append(result)
            for submap in mappen:
                results.extend(self.scan_map(submap, huidige_diepte + 1))
        except PermissionError:
            pass
        return results
    
    def get_mappenboom(self, results: List[ScanResult]) -> str:
        if not results:
            return "Geen mappen gevonden"
        output = []
        for r in results:
            indent = "  " * r.niveau
            status = "☐" if not r.geselecteerd else "☑"
            output.append(f"{indent}{status} 📁 {r.pad.name if r.niveau > 0 else r.pad} ({len(r.bestanden)} bestanden)")
        return "\n".join(output)
    
    def vraag_toestemming_gui(self, parent, results: List[ScanResult]) -> List[ScanResult]:
        if not results:
            return []
        
        dialog = Toplevel(parent)
        dialog.title("🗂️ Selecteer mappen om te archiveren")
        dialog.geometry("1000x750")
        dialog.transient(parent)
        dialog.grab_set()
        
        # Instructie
        instr_frame = Frame(dialog, bg='#1a1a2e', pady=10)
        instr_frame.pack(fill=X)
        Label(instr_frame, text="Selecteer de mappen die je wilt archiveren (vinkjes aanvinken):", 
              font=('Arial', 12, 'bold'), bg='#1a1a2e', fg='#e94560').pack()
        
        # Hoofdframe met scrollbar
        main_frame = Frame(dialog, bg='#1a1a2e')
        main_frame.pack(fill=BOTH, expand=True, padx=10, pady=10)
        
        canvas = Canvas(main_frame, bg='#1a1a2e', highlightthickness=0)
        scrollbar = Scrollbar(main_frame, orient=VERTICAL, command=canvas.yview)
        scrollable_frame = Frame(canvas, bg='#1a1a2e')
        
        scrollable_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=scrollable_frame, anchor=NW)
        canvas.configure(yscrollcommand=scrollbar.set)
        
        canvas.pack(side=LEFT, fill=BOTH, expand=True)
        scrollbar.pack(side=RIGHT, fill=Y)
        
        # Checkbox variabelen
        check_vars = []
        
        for r in results:
            indent = "  " * r.niveau
            var = BooleanVar(value=r.geselecteerd)
            check_vars.append((r, var))
            
            frame = Frame(scrollable_frame, bg='#1a1a2e')
            frame.pack(anchor=W, pady=2)
            
            Label(frame, text=indent, bg='#1a1a2e', fg='white', width=len(indent), anchor=W).pack(side=LEFT)
            cb = Checkbutton(frame, variable=var, bg='#1a1a2e', fg='white', activebackground='#1a1a2e', selectcolor='#1a1a2e')
            cb.pack(side=LEFT)
            
            map_naam = r.pad.name if r.niveau > 0 else str(r.pad)
            Label(frame, text=f"📁 {map_naam} ({len(r.bestanden)} bestanden, {len(r.mappen)} submappen)", 
                  bg='#1a1a2e', fg='#e94560', font=('Arial', 10), anchor=W).pack(side=LEFT, padx=5)
        
        # Knoppen onderaan
        btn_frame = Frame(dialog, bg='#1a1a2e', pady=15)
        btn_frame.pack(fill=X)
        
        def select_all():
            for _, var in check_vars:
                var.set(True)
        
        def select_none():
            for _, var in check_vars:
                var.set(False)
        
        def select_with_files():
            for r, var in check_vars:
                var.set(len(r.bestanden) > 0)
        
        def confirm():
            for r, var in check_vars:
                r.geselecteerd = var.get()
            dialog.destroy()
        
        Button(btn_frame, text="✅ Alles selecteren", command=select_all,
               bg='#27ae60', fg='white', padx=15, pady=5, cursor='hand2', font=('Arial', 10)).pack(side=LEFT, padx=10)
        Button(btn_frame, text="❌ Niets selecteren", command=select_none,
               bg='#e74c3c', fg='white', padx=15, pady=5, cursor='hand2', font=('Arial', 10)).pack(side=LEFT, padx=10)
        Button(btn_frame, text="📄 Alleen mappen met bestanden", command=select_with_files,
               bg='#3498db', fg='white', padx=15, pady=5, cursor='hand2', font=('Arial', 10)).pack(side=LEFT, padx=10)
        Button(btn_frame, text="🚀 Archiveren", command=confirm,
               bg='#e67e22', fg='white', font=('Arial', 11, 'bold'), padx=25, pady=5, cursor='hand2').pack(side=RIGHT, padx=10)
        
        dialog.wait_window()
        
        return [r for r, var in check_vars if var.get()]


# ============================================================================
# DUPLICATE FINDER
# ============================================================================

class DuplicateFinder:
    def __init__(self):
        self.duplicates = {}
        self.scanning = False
        self.stop_scan = False
    
    def fast_hash(self, file_path, block_size=65536):
        hasher = hashlib.md5()
        try:
            with open(file_path, 'rb') as f:
                size = os.path.getsize(file_path)
                if size > 10 * 1024 * 1024:
                    f.seek(0)
                    hasher.update(f.read(block_size))
                    mid_pos = size // 2
                    f.seek(mid_pos)
                    hasher.update(f.read(block_size))
                    f.seek(max(0, size - block_size))
                    hasher.update(f.read(block_size))
                else:
                    for block in iter(lambda: f.read(block_size), b''):
                        hasher.update(block)
            return hasher.hexdigest()
        except:
            return None
    
    def scan_duplicates(self, bron_pad: Path, log_callback=None, progress_callback=None) -> Dict:
        size_dict = defaultdict(list)
        file_count = 0
        stack = [bron_pad]
        processed_dirs = set()
        
        while stack and not self.stop_scan:
            current_dir = stack.pop()
            if current_dir in processed_dirs:
                continue
            processed_dirs.add(current_dir)
            try:
                with os.scandir(current_dir) as entries:
                    for entry in entries:
                        if self.stop_scan:
                            return {}
                        try:
                            if entry.is_file():
                                size = entry.stat().st_size
                                size_dict[size].append(entry.path)
                                file_count += 1
                                if progress_callback and file_count % 100 == 0:
                                    progress_callback(file_count)
                            elif entry.is_dir():
                                stack.append(entry.path)
                        except:
                            pass
            except:
                pass
        
        if self.stop_scan:
            return {}
        
        duplicates = {}
        for size, files in size_dict.items():
            if len(files) > 1 and not self.stop_scan:
                hash_dict = defaultdict(list)
                for f in files:
                    h = self.fast_hash(f)
                    if h:
                        hash_dict[h].append(f)
                for h, paths in hash_dict.items():
                    if len(paths) > 1:
                        duplicates[h] = paths
        
        return duplicates


# ============================================================================
# MAIN APPLICATIE
# ============================================================================

class AIArchiverApp:
    def __init__(self, root):
        self.root = root
        self.root.title("🤖 AI ARCHIVER + DUPLICATE FINDER - Alleen Mappen & Schijven")
        self.root.geometry("1500x950")
        self.root.configure(bg='#1a1a2e')
        
        # Kleuren
        self.bg = '#1a1a2e'
        self.fg = '#eee'
        self.accent = '#0f3460'
        self.highlight = '#e94560'
        
        # Variabelen
        self.watch_folder = StringVar()
        self.target_base = StringVar()
        self.scan_folder = StringVar()
        self.duplicate_source = StringVar()
        self.duplicate_dest = StringVar()
        self.ai_model = StringVar(value="facebook/bart-large-mnli")
        self.max_depth = IntVar(value=4)
        self.selected_drive = StringVar()
        
        self.running = False
        self.sorteerder = None
        self.scanner = SubmapScanner()
        self.scan_results = []
        self.duplicate_finder = DuplicateFinder()
        self.duplicates = {}
        self.drives = []
        
        self._setup_ui()
        self._load_settings()
        self._detect_drives()
        
        if not AI_AVAILABLE:
            self._log("⚠️ AI niet beschikbaar. Alleen trefwoordherkenning.")
    
    def _detect_drives(self):
        """Detecteer alle beschikbare schijven"""
        self.drives = DriveDetector.get_all_drives()
        self._log(f"💾 {len(self.drives)} schijven gedetecteerd")
        
        # Update de drive combobox
        if hasattr(self, 'drive_combo'):
            drive_list = [f"{d['letter']}:\\ ({d['type']})" for d in self.drives]
            self.drive_combo['values'] = drive_list
    
    def _setup_ui(self):
        # Notebook voor tabs
        self.notebook = ttk.Notebook(self.root)
        self.notebook.pack(fill=BOTH, expand=True, padx=10, pady=10)
        
        # Tab 1: AI Archiver
        self.archive_frame = Frame(self.notebook, bg=self.bg)
        self.notebook.add(self.archive_frame, text="🤖 AI ARCHIVER - Alleen Mappen")
        self._setup_archive_tab()
        
        # Tab 2: Duplicate Finder
        self.duplicate_frame = Frame(self.notebook, bg=self.bg)
        self.notebook.add(self.duplicate_frame, text="🔍 DUPLICATE FINDER - Alleen Mappen")
        self._setup_duplicate_tab()
        
        # Tab 3: Logboek
        self.log_frame = Frame(self.notebook, bg=self.bg)
        self.notebook.add(self.log_frame, text="📋 LOGBOEK")
        self._setup_log_tab()
    
    def _setup_archive_tab(self):
        main = Frame(self.archive_frame, bg=self.bg)
        main.pack(fill=BOTH, expand=True, padx=15, pady=15)
        
        # Titel
        Label(main, text="📁 AI GESTUURD ARCHIVEREN - Alleen Mappen & Schijven", 
              font=('Arial', 16, 'bold'), bg=self.bg, fg=self.highlight).pack(pady=10)
        
        # Configuratie
        cfg = LabelFrame(main, text="Configuratie", bg=self.bg, fg=self.fg, font=('Arial', 11, 'bold'))
        cfg.pack(fill=X, pady=10)
        
        f1 = Frame(cfg, bg=self.bg)
        f1.pack(fill=X, padx=10, pady=5)
