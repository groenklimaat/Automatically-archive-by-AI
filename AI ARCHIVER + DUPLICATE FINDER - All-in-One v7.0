        Entry(f1, textvariable=self.target_base, width=60, bg='#16213e', fg=self.fg, insertbackground='white', font=('Arial', 10)).pack(side=LEFT, padx=5)
        Button(f1, text="📁 Bladeren", command=self._select_target_folder, bg=self.accent, fg=self.fg, cursor='hand2', font=('Arial', 10)).pack(side=LEFT)
        
