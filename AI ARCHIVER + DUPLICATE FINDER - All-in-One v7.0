        f2.pack(fill=X, padx=10, pady=5)
        Label(f2, text="AI Model:", bg=self.bg, fg=self.fg, width=18, anchor=W, font=('Arial', 10)).pack(side=LEFT)
        ttk.Combobox(f2, textvariable=self.ai_model, values=('facebook/bart-large-mnli', 'typeform/distilbert-base-uncased-mnli'), width=55).pack(side=LEFT, padx=5)
        Button(f2, text="🔄 Laad AI", command=self._reload_ai, bg=self.accent, fg=self.fg, cursor='hand2', font=('Arial', 10)).pack(side=LEFT)
        
        # Schijfselectie sectie
        drive_frame = LabelFrame(main, text="💾 Snelle Schijfselectie", bg=self.bg, fg=self.fg, font=('Arial', 11, 'bold'))
        drive_frame.pack(fill=X, pady=10)
        
