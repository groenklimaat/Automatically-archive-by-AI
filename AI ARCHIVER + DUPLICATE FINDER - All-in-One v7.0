        self.drive_combo.pack(side=LEFT, padx=5)
        Button(f3, text="💾 Gebruik deze schijf", command=self._use_selected_drive, bg='#27ae60', fg='white', cursor='hand2', font=('Arial', 10)).pack(side=LEFT, padx=5)
        
        # Submap scanner sectie
        scanner_frame = LabelFrame(main, text="🗂️ Map Scanner (Alleen mappen - geen bestanden)", bg=self.bg, fg=self.fg, font=('Arial', 11, 'bold'))
        scanner_frame.pack(fill=X, pady=10)
        
        f4 = Frame(scanner_frame, bg=self.bg)
        f4.pack(fill=X, padx=10, pady=5)
        Label(f4, text="Te scannen map:", bg=self.bg, fg=self.fg, width=18, anchor=W, font=('Arial', 10)).pack(side=LEFT)
        Entry(f4, textvariable=self.scan_folder, width=60, bg='#16213e', fg=self.fg, font=('Arial', 10)).pack(side=LEFT, padx=5)
        Button(f4, text="📁 Bladeren (alleen mappen)", command=self._select_scan_folder, bg=self.accent, fg=self.fg, cursor='hand2', font=('Arial', 10)).pack(side=LEFT)
        
        f5 = Frame(scanner_frame, bg=self.bg)
        f5.pack(fill=X, padx=10, pady=5)
        Label(f5, text="Max diepte (1-4):", bg=self.bg, fg=self.fg, width=18, anchor=W, font=('Arial', 10)).pack(side=LEFT)
        Spinbox(f5, from_=1, to=4, textvariable=self.max_depth, width=10, bg='#16213e', fg=self.fg, font=('Arial', 10)).pack(side=LEFT)
        
        btn_frame = Frame(scanner_frame, bg=self.bg)
        btn_frame.pack(pady=10)
        Button(btn_frame, text="🔍 SCAN SUBMAPPEN", command=self._start_scan, 
               bg='#27ae60', fg='white', font=('Arial', 11, 'bold'), padx=25, pady=8, cursor='hand2').pack(side=LEFT, padx=10)
        Button(btn_frame, text="🚀 ARCHIVEER GESELECTEERD", command=self._archive_selected, 
               bg='#e67e22', fg='white', font=('Arial', 11, 'bold'), padx=25, pady=8, cursor='hand2').pack(side=LEFT, padx=10)
        
        # Resultaten lijst
        result_frame = LabelFrame(main, text="Geselecteerde mappen voor archivering", bg=self.bg, fg=self.fg, font=('Arial', 11, 'bold'))
        result_frame.pack(fill=BOTH, expand=True, pady=10)
        
        self.scan_listbox = Listbox(result_frame, bg='#16213e', fg=self.fg, selectbackground=self.highlight, height=8, font=('Consolas', 10))
        self.scan_listbox.pack(fill=BOTH, expand=True, padx=5, pady=5)
    
    def _setup_duplicate_tab(self):
        main = Frame(self.duplicate_frame, bg=self.bg)
        main.pack(fill=BOTH, expand=True, padx=15, pady=15)
        
        Label(main, text="🔍 DUPLICATE BESTANDEN FINDER - Alleen Mappen & Schijven", 
              font=('Arial', 16, 'bold'), bg=self.bg, fg=self.highlight).pack(pady=10)
        
        # Configuratie
        cfg = LabelFrame(main, text="Configuratie", bg=self.bg, fg=self.fg, font=('Arial', 11, 'bold'))
        cfg.pack(fill=X, pady=10)
        
        f1 = Frame(cfg, bg=self.bg)
        f1.pack(fill=X, padx=10, pady=5)
        Label(f1, text="Bronmap/schijf:", bg=self.bg, fg=self.fg, width=18, anchor=W, font=('Arial', 10)).pack(side=LEFT)
        Entry(f1, textvariable=self.duplicate_source, width=60, bg='#16213e', fg=self.fg, font=('Arial', 10)).pack(side=LEFT, padx=5)
        Button(f1, text="📁 Bladeren (alleen mappen)", command=self._select_dup_source, bg=self.accent, fg=self.fg, cursor='hand2', font=('Arial', 10)).pack(side=LEFT)
        
        f2 = Frame(cfg, bg=self.bg)
        f2.pack(fill=X, padx=10, pady=5)
        Label(f2, text="Doelmap voor duplicaten:", bg=self.bg, fg=self.fg, width=18, anchor=W, font=('Arial', 10)).pack(side=LEFT)
        Entry(f2, textvariable=self.duplicate_dest, width=60, bg='#16213e', fg=self.fg, font=('Arial', 10)).pack(side=LEFT, padx=5)
        Button(f2, text="📁 Bladeren (alleen mappen)", command=self._select_dup_dest, bg=self.accent, fg=self.fg, cursor='hand2', font=('Arial', 10)).pack(side=LEFT)
        
        # Schijfselectie voor duplicates
        drive_frame = LabelFrame(main, text="💾 Of selecteer een schijf om te scannen", bg=self.bg, fg=self.fg, font=('Arial', 11, 'bold'))
        drive_frame.pack(fill=X, pady=10)
        
        f3 = Frame(drive_frame, bg=self.bg)
        f3.pack(fill=X, padx=10, pady=5)
        Label(f3, text="Selecteer schijf voor scan:", bg=self.bg, fg=self.fg, width=22, anchor=W, font=('Arial', 10)).pack(side=LEFT)
        self.dup_drive_combo = ttk.Combobox(f3, width=55)
        self.dup_drive_combo.pack(side=LEFT, padx=5)
        Button(f3, text="💾 Scan deze schijf", command=self._use_selected_dup_drive, bg='#27ae60', fg='white', cursor='hand2', font=('Arial', 10)).pack(side=LEFT, padx=5)
        
        # Status
        self.dup_status = Label(main, text="✅ Klaar voor scan", bg=self.bg, fg=self.fg, font=('Arial', 10))
        self.dup_status.pack(pady=5)
        
        self.dup_counter = Label(main, text="Bestanden gescand: 0", bg=self.bg, fg=self.highlight, font=('Arial', 11, 'bold'))
        self.dup_counter.pack()
        
        # Progress bar
        self.dup_progress = ttk.Progressbar(main, mode='indeterminate')
        self.dup_progress.pack(fill=X, pady=5)
        
        # Knoppen
        btn_frame = Frame(main, bg=self.bg)
        btn_frame.pack(pady=10)
        self.scan_dup_btn = Button(btn_frame, text="🔍 SCAN OP DUPLICATEN", command=self._start_dup_scan, 
                                   bg='#27ae60', fg='white', font=('Arial', 11, 'bold'), padx=25, pady=8, cursor='hand2')
        self.scan_dup_btn.pack(side=LEFT, padx=10)
        self.stop_dup_btn = Button(btn_frame, text="⏹ STOP SCAN", command=self._stop_dup_scan, 
                                   bg='#e74c3c', fg='white', font=('Arial', 11, 'bold'), padx=25, pady=8, state=DISABLED, cursor='hand2')
        self.stop_dup_btn.pack(side=LEFT, padx=10)
        self.move_dup_btn = Button(btn_frame, text="📦 VERPLAATS DUPLICATEN", command=self._move_duplicates, 
                                   bg='#e67e22', fg='white', font=('Arial', 11, 'bold'), padx=25, pady=8, state=DISABLED, cursor='hand2')
        self.move_dup_btn.pack(side=LEFT, padx=10)
        self.del_dup_btn = Button(btn_frame, text="🗑️ VERWIJDER DUPLICATEN", command=self._delete_duplicates, 
                                  bg='#e74c3c', fg='white', font=('Arial', 11, 'bold'), padx=25, pady=8, state=DISABLED, cursor='hand2')
        self.del_dup_btn.pack(side=LEFT, padx=10)
        
        # Resultaten lijst
        result_frame = LabelFrame(main, text="Gevonden duplicaten", bg=self.bg, fg=self.fg, font=('Arial', 11, 'bold'))
        result_frame.pack(fill=BOTH, expand=True, pady=10)
        
        scroll_y = Scrollbar(result_frame)
        scroll_y.pack(side=RIGHT, fill=Y)
        
        self.dup_listbox = Listbox(result_frame, bg='#16213e', fg=self.fg, selectbackground=self.highlight, font=('Consolas', 9), yscrollcommand=scroll_y.set)
        self.dup_listbox.pack(side=LEFT, fill=BOTH, expand=True)
        scroll_y.config(command=self.dup_listbox.yview)
    
    def _setup_log_tab(self):
        main = Frame(self.log_frame, bg=self.bg)
        main.pack(fill=BOTH, expand=True, padx=15, pady=15)
        
        Label(main, text="📋 ACTIVITEITEN LOG", font=('Arial', 16, 'bold'),
              bg=self.bg, fg=self.highlight).pack(pady=10)
        
        log_controls = Frame(main, bg=self.bg)
        log_controls.pack(fill=X, pady=5)
        Button(log_controls, text="🗑 Wissen", command=self._clear_log, bg=self.accent, fg=self.fg, cursor='hand2', font=('Arial', 10)).pack(side=LEFT, padx=5)
        Button(log_controls, text="📋 Kopieer", command=self._copy_log, bg=self.accent, fg=self.fg, cursor='hand2', font=('Arial', 10)).pack(side=LEFT, padx=5)
        
        self.log_text = scrolledtext.ScrolledText(main, bg='#16213e', fg=self.fg, font=('Consolas', 10))
        self.log_text.pack(fill=BOTH, expand=True)
    
    def _log(self, msg):
        timestamp = datetime.now().strftime("%H:%M:%S")
        self.log_text.insert(END, f"[{timestamp}] {msg}\n")
        self.log_text.see(END)
        self.root.update_idletasks()
    
    def _clear_log(self):
        self.log_text.delete(1.0, END)
    
    def _copy_log(self):
        self.root.clipboard_clear()
        self.root.clipboard_append(self.log_text.get(1.0, END))
        self._log("📋 Logboek gekopieerd")
    
    def _select_target_folder(self):
        folder = filedialog.askdirectory(title="Selecteer doelmap voor archief")
        if folder:
            self.target_base.set(folder)
            self._log(f"📁 Doelmap geselecteerd: {folder}")
    
    def _select_scan_folder(self):
        folder = filedialog.askdirectory(title="Selecteer map om te scannen (alleen mappen)")
        if folder:
            self.scan_folder.set(folder)
            self._log(f"📁 Scanmap geselecteerd: {folder}")
    
    def _select_dup_source(self):
        folder = filedialog.askdirectory(title="Selecteer bronmap voor duplicate scan (alleen mappen)")
        if folder:
            self.duplicate_source.set(folder)
            self._log(f"📁 Duplicate bronmap: {folder}")
    
    def _select_dup_dest(self):
        folder = filedialog.askdirectory(title="Selecteer doelmap voor duplicaten")
        if folder:
            self.duplicate_dest.set(folder)
            self._log(f"📁 Duplicate doelmap: {folder}")
    
    def _use_selected_drive(self):
        """Gebruik de geselecteerde schijf als scanbron"""
        selection = self.drive_combo.get()
        if selection:
            drive_letter = selection.split(':')[0] + ':'
            self.scan_folder.set(drive_letter + '\\')
            self._log(f"💾 Schijf geselecteerd voor scanning: {drive_letter}")
    
    def _use_selected_dup_drive(self):
        """Gebruik de geselecteerde schijf voor duplicate scan"""
        selection = self.dup_drive_combo.get()
        if selection:
            drive_letter = selection.split(':')[0] + ':'
            self.duplicate_source.set(drive_letter + '\\')
            self._log(f"💾 Schijf geselecteerd voor duplicate scan: {drive_letter}")
    
    def _reload_ai(self):
        if not self.target_base.get():
            messagebox.showwarning("Waarschuwing", "Selecteer eerst een doelmap")
            return
        if not self.sorteerder:
            self.sorteerder = HVACSorteerder(Path(self.target_base.get()))
        self._log("🔄 AI model laden...")
        ok = self.sorteerder.laad_ai_model(self.ai_model.get())
        if ok:
            self._log(f"✅ AI model geladen: {self.ai_model.get()}")
        else:
            self._log("❌ AI laden mislukt - valt terug op trefwoorden")
    
    def _start_scan(self):
        if not self.scan_folder.get():
            messagebox.showwarning("Waarschuwing", "Selecteer een map of schijf om te scannen")
            return
        scan_pad = Path(self.scan_folder.get())
        if not scan_pad.exists():
            messagebox.showerror("Fout", "Map/schijf bestaat niet")
            return
        
        max_diepte = self.max_depth.get()
        self.scanner = SubmapScanner(max_diepte=max_diepte)
        self._log(f"🔍 Scannen: {scan_pad} (max diepte: {max_diepte} niveaus)")
        self._log("📌 Alleen mappen worden gescand - geen bestanden worden geopend")
        
        self.root.config(cursor="watch")
        self.root.update()
        
        try:
            results = self.scanner.scan_map(scan_pad)
            self._log(f"✅ {len(results)} mappen gevonden")
            
            geselecteerd = self.scanner.vraag_toestemming_gui(self.root, results)
            self.scan_results = geselecteerd
            
            self.scan_listbox.delete(0, END)
            for r in geselecteerd:
                indent = "  " * r.niveau
                self.scan_listbox.insert(END, f"{indent}📁 {r.pad.name if r.niveau > 0 else r.pad} ({len(r.bestanden)} bestanden, {len(r.mappen)} submappen)")
            
            self._log(f"✅ {len(geselecteerd)} mappen geselecteerd voor archivering")
        except Exception as e:
            self._log(f"❌ Fout bij scannen: {e}")
            messagebox.showerror("Fout", f"Fout bij scannen: {e}")
        finally:
            self.root.config(cursor="")
    
    def _archive_selected(self):
        if not self.scan_results:
            messagebox.showwarning("Waarschuwing", "Geen mappen geselecteerd. Scan eerst en selecteer mappen.")
            return
        if not self.sorteerder:
            if not self.target_base.get():
                messagebox.showwarning("Waarschuwing", "Selecteer eerst een doelmap")
                return
            self.sorteerder = HVACSorteerder(Path(self.target_base.get()))
        
        totaal = sum(len(r.bestanden) for r in self.scan_results)
        if totaal == 0:
            self._log("📭 Geen bestanden gevonden in geselecteerde mappen")
            messagebox.showinfo("Info", "Geen bestanden gevonden in geselecteerde mappen")
            return
        
        antwoord = messagebox.askyesno("Bevestiging", f"Weet je zeker dat je {totaal} bestanden wilt archiveren?\n\nDe bestanden worden verplaatst naar de gestructureerde archiefmap!")
        if not antwoord:
            self._log("❌ Archivering geannuleerd")
            return
        
        self._log(f"🚀 Archiveren van {totaal} bestanden...")
        verwerkt = 0
        for result in self.scan_results:
            self._log(f"📁 Verwerken: {result.pad}")
            for bestand in result.bestanden:
                if self.sorteerder.sorteer_bestand(bestand, self._log):
                    verwerkt += 1
                self.root.update_idletasks()
        
        self._log(f"✨ Klaar! {verwerkt} bestanden verplaatst.")
        messagebox.showinfo("Voltooid", f"{verwerkt} bestanden succesvol gearchiveerd!")
    
    def _start_dup_scan(self):
        if not self.duplicate_source.get():
            messagebox.showwarning("Waarschuwing", "Selecteer een bronmap of schijf")
            return
        
        bron = self.duplicate_source.get()
        self._log(f"🔍 Starten duplicate scan op: {bron}")
        
        self.duplicates = {}
        self.dup_listbox.delete(0, END)
        self.move_dup_btn.config(state=DISABLED)
        self.del_dup_btn.config(state=DISABLED)
        self.scan_dup_btn.config(state=DISABLED)
        self.stop_dup_btn.config(state=NORMAL)
        self.dup_progress.start()
        
        self.duplicate_finder.stop_scan = False
        self.dup_status.config(text="🔍 Bezig met scannen...", fg='#f39c12')
        
        self.dup_finder_thread = threading.Thread(target=self._scan_duplicates_thread, daemon=True)
        self.dup_finder_thread.start()
    
    def _scan_duplicates_thread(self):
        self.duplicate_finder.scanning = True
        
        def progress_callback(count):
            self.dup_counter.config(text=f"Bestanden gescand: {count:,}")
            self.root.update_idletasks()
        
        self.duplicates = self.duplicate_finder.scan_duplicates(
            Path(self.duplicate_source.get()),
            log_callback=self._log,
            progress_callback=progress_callback
        )
        
        self.duplicate_finder.scanning = False
        self.root.after(0, self._display_duplicates)
    
    def _stop_dup_scan(self):
        self.duplicate_finder.stop_scan = True
        self._log("⏹️ Duplicate scan gestopt door gebruiker")
        self.dup_status.config(text="⏹️ Scan gestopt", fg='#e74c3c')
    
    def _display_duplicates(self):
        self.dup_progress.stop()
        self.scan_dup_btn.config(state=NORMAL)
        self.stop_dup_btn.config(state=DISABLED)
        
        total = 0
        for paths in self.duplicates.values():
            total += len(paths) - 1
            original = paths[0]
            self.dup_listbox.insert(END, f"📁 {os.path.basename(original)} - {len(paths)}x")
            for dup in paths[1:]:
                self.dup_listbox.insert(END, f"  └─ {dup}")
            self.dup_listbox.insert(END, "")
        
        if total > 0:
            self.move_dup_btn.config(state=NORMAL)
            self.del_dup_btn.config(state=NORMAL)
            self._log(f"✅ {len(self.duplicates)} groepen, {total} duplicaten gevonden")
            self.dup_status.config(text=f"✅ {len(self.duplicates)} groepen, {total} duplicaten", fg='#2ecc71')
            self.dup_counter.config(text=f"Duplicaten gevonden: {total}")
        else:
            self._log("✅ Geen duplicaten gevonden")
            self.dup_status.config(text="✅ Geen duplicaten gevonden", fg='#2ecc71')
            self.dup_counter.config(text="Geen duplicaten gevonden")
    
    def _move_duplicates(self):
        if not self.duplicate_dest.get():
            messagebox.showwarning("Waarschuwing", "Selecteer een doelmap voor duplicaten")
            return
        
        total = sum(len(p) - 1 for p in self.duplicates.values())
        if total == 0:
            messagebox.showinfo("Info", "Geen duplicaten om te verplaatsen")
            return
        
        antwoord = messagebox.askyesno("Bevestiging", f"Verplaats {total} duplicaten naar:\n{self.duplicate_dest.get()}?")
        if not antwoord:
            return
        
        moved = 0
        for paths in self.duplicates.values():
            for dup in paths[1:]:
                try:
                    dest = Path(self.duplicate_dest.get()) / Path(dup).name
                    counter = 1
                    while dest.exists():
                        dest = Path(self.duplicate_dest.get()) / f"{Path(dup).stem}_{counter}{Path(dup).suffix}"
                        counter += 1
                    shutil.move(dup, dest)
                    moved += 1
                    self.dup_status.config(text=f"📦 Verplaatst: {moved}/{total}")
                    self.root.update_idletasks()
                except Exception as e:
                    self._log(f"❌ Fout bij verplaatsen {dup}: {e}")
        
        self._log(f"✅ {moved} duplicaten verplaatst naar {self.duplicate_dest.get()}")
        messagebox.showinfo("Klaar", f"{moved} bestanden verplaatst!")
        self._start_dup_scan()
    
    def _delete_duplicates(self):
        total = sum(len(p) - 1 for p in self.duplicates.values())
        if total == 0:
            messagebox.showinfo("Info", "Geen duplicaten om te verwijderen")
            return
        
        antwoord = messagebox.askyesno("⚠️ WAARSCHUWING", f"Permanent verwijderen van {total} bestanden?\n\nDit kan niet ongedaan worden gemaakt!")
        if not antwoord:
            return
        
        deleted = 0
        for paths in self.duplicates.values():
            for dup in paths[1:]:
                try:
                    os.chmod(dup, stat.S_IWRITE)
                    os.remove(dup)
                    deleted += 1
                    self.dup_status.config(text=f"🗑️ Verwijderd: {deleted}/{total}")
                    self.root.update_idletasks()
                except Exception as e:
                    self._log(f"❌ Fout bij verwijderen {dup}: {e}")
        
        self._log(f"✅ {deleted} duplicaten verwijderd")
        messagebox.showinfo("Klaar", f"{deleted} bestanden verwijderd!")
        self._start_dup_scan()
    
    def _save_settings(self):
        settings = {
            'target_base': self.target_base.get(),
            'scan_folder': self.scan_folder.get(),
            'duplicate_source': self.duplicate_source.get(),
            'duplicate_dest': self.duplicate_dest.get(),
            'ai_model': self.ai_model.get(),
            'max_depth': self.max_depth.get()
        }
        try:
            with open(Path.home() / ".ai_archiver_settings.json", 'w') as f:
                json.dump(settings, f, indent=2)
            self._log("💾 Instellingen opgeslagen")
        except Exception as e:
            self._log(f"❌ Opslaan mislukt: {e}")
    
    def _load_settings(self):
        try:
            settings_file = Path.home() / ".ai_archiver_settings.json"
            if settings_file.exists():
                with open(settings_file, 'r') as f:
                    s = json.load(f)
                self.target_base.set(s.get('target_base', ''))
                self.scan_folder.set(s.get('scan_folder', ''))
                self.duplicate_source.set(s.get('duplicate_source', ''))
                self.duplicate_dest.set(s.get('duplicate_dest', ''))
                self.ai_model.set(s.get('ai_model', 'facebook/bart-large-mnli'))
                self.max_depth.set(s.get('max_depth', 4))
                self._log("📂 Instellingen geladen")
        except Exception as e:
            self._log(f"⚠️ Laden mislukt: {e}")


# ============================================================================
# MAIN
# ============================================================================

def main():
    root = Tk()
    app = AIArchiverApp(root)
    
    def on_closing():
        if hasattr(app, 'duplicate_finder') and app.duplicate_finder.scanning:
            app.duplicate_finder.stop_scan = True
            time.sleep(1)
        root.destroy()
    
    root.protocol("WM_DELETE_WINDOW", on_closing)
    root.mainloop()

if __name__ == "__main__":
    main()
