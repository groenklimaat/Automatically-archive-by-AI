# ================================================================
#  JSON HELPERS
# ================================================================
def laad_json(pad, standaard):
    if not os.path.exists(pad):
        return standaard
    try:
        with open(pad, "r", encoding="utf-8") as f:
            return json.load(f)
    except (json.JSONDecodeError, OSError) as e:
        log.warning(f"Kon {pad} niet lezen ({e}).")
        return standaard

def sla_json_atomisch_op(pad, data):
    tmp = pad + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, pad)

def log_meting(tekst):
    try:
        with open(METINGEN_FILE, "a", encoding="utf-8") as f:
            f.write(f"{datetime.now().isoformat(timespec='seconds')}\t{tekst}\n")
    except OSError as e:
        log.warning(f"Kon meting niet wegschrijven: {e}")

# ================================================================
#  FORMULES
# ================================================================
def capaciteit_naar_farad(capaciteit_mah, spanning_v):
    if spanning_v <= 0:
        return 0.0
    return (capaciteit_mah * 3.6) / spanning_v

def bereken_watt(spanning_v, stroom_ma):
    if spanning_v <= 0 or stroom_ma <= 0:
        return 0.0
    return spanning_v * (stroom_ma / 1000.0)

def bereken_stroom_ma(spanning_v, watt):
    if spanning_v <= 0 or watt <= 0:
        return 0.0
    return (watt / spanning_v) * 1000.0

def mah_naar_wh(capaciteit_mah, spanning_v):
    """Wattuur = mAh × V / 1000."""
    if spanning_v <= 0:
        return 0.0
    return capaciteit_mah * spanning_v / 1000.0

def wh_naar_mah(wh, spanning_v):
    if spanning_v <= 0:
        return 0.0
    return wh * 1000.0 / spanning_v

def oplaadtijd_uren(batterij_wh, laad_vermogen_w, rendement=0.85):
    """Oplaadtijd in uur = E / (P × η)."""
    if laad_vermogen_w <= 0:
        return 0.0
    return batterij_wh / (laad_vermogen_w * rendement)

def ontlaadtijd_uren(batterij_wh, ontlaad_vermogen_w):
    """Ontlaadtijd in uur = E / P."""
    if ontlaad_vermogen_w <= 0:
        return 0.0
    return batterij_wh / ontlaad_vermogen_w

def bereken_rc(spanning_v, stroom_ma, capaciteit_mah):
    if stroom_ma <= 0 or spanning_v <= 0:
        return None
    stroom_a = stroom_ma / 1000.0
    R = spanning_v / stroom_a
    C = capaciteit_naar_farad(capaciteit_mah, spanning_v)
    tau = R * C
    return {"R": R, "C": C, "tau": tau}

def resterende_tijd_seconden(v0, v_min, tau):
    if v0 <= 0 or v_min <= 0 or tau <= 0 or v_min >= v0:
        return 0.0
    return -tau * math.log(v_min / v0)

def formatteer_tijd(seconden):
    if seconden <= 0:
        return "—"
    uren    = int(seconden // 3600)
    minuten = int((seconden % 3600) // 60)
    sec     = int(seconden % 60)
    return f"{uren}u {minuten:02d}m {sec:02d}s"

def formatteer_uren(uur_decimaal):
    if uur_decimaal <= 0:
        return "—"
    uren    = int(uur_decimaal)
    minuten = int(round((uur_decimaal - uren) * 60))
    return f"{uren}u {minuten:02d}m"

# ================================================================
#  HX711 WRAPPER
# ================================================================
class Weegschaal:
    def __init__(self):
        self.hx = None
        self.beschikbaar = HX711_BESCHIKBAAR
        self.referentie_unit = None
        self.dout_pin = CONFIG["dout_pin"]
        self.sck_pin  = CONFIG["sck_pin"]

    def init(self, dout_pin=None, sck_pin=None):
        if not self.beschikbaar:
            return False
        if dout_pin is not None:
            self.dout_pin = dout_pin
        if sck_pin is not None:
            self.sck_pin = sck_pin
        try:
            self.hx = HX711(dout_pin=self.dout_pin, pd_sck_pin=self.sck_pin)
            self.hx.set_reading_format("MSB", "MSB")
            self.hx.set_reference_unit(1)
            log.info(f"HX711 geïnitialiseerd (DT=GPIO{self.dout_pin}, "
                     f"SCK=GPIO{self.sck_pin}).")
            return True
        except Exception as e:
            log.error(f"HX711 init fout: {e}")
            self.beschikbaar = False
            self.hx = None
            return False

    def laad_kalibratie(self):
        data = laad_json(KALIBRATIE_FILE, {})
        if "referentie_unit" in data:
            self.referentie_unit = data["referentie_unit"]
            if self.hx is not None:
                self.hx.set_reference_unit(self.referentie_unit)
            log.info(f"Kalibratie geladen (unit={self.referentie_unit:.4f})")
            return True
        return False

    def tarreer(self):
        if self.hx is None:
            return False
        try:
            self.hx.tare()
            log.info("HX711 getareerd.")
            return True
        except Exception as e:
            log.error(f"Tareerfout: {e}")
            return False

    def kalibreer(self, bekend_gram):
        if self.hx is None:
            return False
        try:
            self.hx.tare()
            time.sleep(1)
            ruwe = self.hx.get_weight(10)
            if ruwe == 0:
                return False
            self.referentie_unit = ruwe / bekend_gram
            self.hx.set_reference_unit(self.referentie_unit)
            sla_json_atomisch_op(KALIBRATIE_FILE, {
                "referentie_unit": self.referentie_unit,
                "bekend_gewicht":  bekend_gram,
                "dout_pin":        self.dout_pin,
                "sck_pin":         self.sck_pin,
                "datum":           datetime.now().isoformat(timespec="seconds"),
            })
            log.info(f"Kalibratie opgeslagen: unit={self.referentie_unit:.4f}")
            return True
        except Exception as e:
            log.error(f"Kalibratiefout: {e}")
            return False

    def lees(self):
        if not self.beschikbaar or self.hx is None:
            import random
            return round(random.uniform(50, 150), 1)
        try:
            return round(self.hx.get_weight(CONFIG["metingen_gemiddelde"]), 1)
        except Exception as e:
            log.error(f"Fout bij lezen gewicht: {e}")
            return None

# ================================================================
#  INA219 WRAPPER
# ================================================================
class StroomMeter:
    def __init__(self):
        self.ina = None
        self.beschikbaar = INA219_BESCHIKBAAR

    def init(self):
        if not self.beschikbaar:
            return False
        try:
            self.ina = INA219(CONFIG["ina219_shunt_ohm"],
                              address=CONFIG["ina219_adres"])
            self.ina.configure()
            log.info("INA219 geïnitialiseerd.")
            return True
        except Exception as e:
            log.error(f"INA219 init fout: {e}")
            self.beschikbaar = False
            return False

    def lees(self):
        if not self.beschikbaar or self.ina is None:
            return None, None
        try:
            return round(self.ina.voltage(), 3), round(self.ina.current(), 1)
        except Exception as e:
            log.error(f"INA219 leesfout: {e}")
            return None, None

