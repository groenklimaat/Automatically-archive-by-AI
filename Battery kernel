    # ============================================================
    #  ZONNE-CYCLUS BEREKENINGEN
    # ============================================================
    def _lees_float(self, entry, naam):
        try:
            return float(entry.get().replace(",", "."))
        except ValueError:
            messagebox.showerror("Invoerfout",
                                 f"Ongeldige waarde voor {naam}.")
            return None

    def bereken_wh_uit_mah(self):
        mah = self._lees_float(self.bat_mah_entry, "mAh")
        v   = self._lees_float(self.bat_v_entry, "nominale spanning")
        if mah is None or v is None:
            return
        wh = mah_naar_wh(mah, v)
        self.bat_wh_entry.delete(0, tk.END)
        self.bat_wh_entry.insert(0, f"{wh:.2f}")
        self.status.set(f"Batterij: {mah:.0f} mAh × {v:.2f} V = {wh:.2f} Wh")
        log.info(f"Wh-omrekening: {mah} mAh × {v} V = {wh:.2f} Wh")

    def neem_watt_over(self):
        """Neemt het wattage over uit het batterij-tabblad."""
        try:
            watt = float(self.watt_entry.get().replace(",", "."))
        except ValueError:
            messagebox.showwarning("Wattage",
                                   "Geen geldig wattage in batterij-tabblad.")
            return
        self.ontlaad_w_entry.delete(0, tk.END)
        self.ontlaad_w_entry.insert(0, f"{watt:.3f}")
        self.status.set(f"Ontlaadvermogen overgenomen: {watt:.3f} W")

    def bereken_zonne_cyclus(self):
        # Invoer lezen
        wh        = self._lees_float(self.bat_wh_entry,      "batterij Wh")
        p_laad    = self._lees_float(self.laad_w_entry,      "laadvermogen")
        rend_pct  = self._lees_float(self.laad_rend_entry,   "rendement")
        zon_uren  = self._lees_float(self.zon_uren_entry,    "zonuren")
        p_ontlaad = self._lees_float(self.ontlaad_w_entry,   "ontlaadvermogen")
        if None in (wh, p_laad, rend_pct, zon_uren, p_ontlaad):
            return

        if wh <= 0 or p_laad <= 0 or p_ontlaad <= 0 or zon_uren <= 0:
            messagebox.showerror("Invoerfout",
                                 "Alle waarden moeten > 0 zijn.")
            return
        if not (0 < rend_pct <= 100):
            messagebox.showerror("Invoerfout",
                                 "Rendement moet tussen 0 en 100 % liggen.")
            return

        rend = rend_pct / 100.0

        # Berekeningen
        t_laad_u    = oplaadtijd_uren(wh, p_laad, rend)
        t_ontlaad_u = ontlaadtijd_uren(wh, p_ontlaad)

        energie_per_dag = p_laad * zon_uren * rend        # Wh/dag
        verbruik_dag    = p_ontlaad * 24.0                # Wh/dag
        netto           = energie_per_dag - verbruik_dag

        # Hoe vaak past een volledige cyclus in 24 u?
        cyclus_uren = t_laad_u + t_ontlaad_u
        cycli_per_dag = 24.0 / cyclus_uren if cyclus_uren > 0 else 0

        # Hoeveel uur zon nodig om batterij vol te laden?
        uren_vol = t_laad_u

        # Conclusie
        if netto > 0:
            conclusie = (f"✅ Je wint {netto:.1f} Wh per dag — "
                         f"de batterij raakt vol.")
        elif netto < 0:
            conclusie = (f"⚠  Je verliest {abs(netto):.1f} Wh per dag — "
                         f"de batterij raakt leeg.")
        else:
            conclusie = "⚖  Perfect in balans (netto = 0 Wh/dag)."

        tekst = (
            f"── BATTERIJ ─────────────────────────────────\n"
            f"  Energie inhoud          : {wh:.2f} Wh\n"
            f"  (equivalent in mAh × V) : "
            f"{wh_naar_mah(wh, 3.7):.0f} mAh @ 3.7 V\n\n"
            f"── LADEN (zonnepaneel) ─────────────────────\n"
            f"  Laadvermogen            : {p_laad:.2f} W\n"
            f"  Rendement               : {rend_pct:.1f} % "
            f"(η = {rend:.2f})\n"
            f"  Effectieve zonuren/dag  : {zon_uren:.1f} u\n"
            f"  ► Oplaadtijd van leeg → vol:\n"
            f"      t = E / (P × η) = {wh:.2f} / "
            f"({p_laad:.2f} × {rend:.2f})\n"
            f"      = {t_laad_u:.3f} u   ({formatteer_uren(t_laad_u)})\n"
            f"  ► Energie per zonnige dag:\n"
            f"      E = {p_laad:.2f} × {zon_uren:.1f} × {rend:.2f}\n"
            f"      = {energie_per_dag:.2f} Wh/dag\n\n"
            f"── ONTLADEN (verbruiker) ───────────────────\n"
            f"  Ontlaadvermogen         : {p_ontlaad:.2f} W\n"
            f"  ► Ontlaadtijd van vol → leeg:\n"
            f"      t = E / P = {wh:.2f} / {p_ontlaad:.2f}\n"
            f"      = {t_ontlaad_u:.3f} u   ({formatteer_uren(t_ontlaad_u)})\n"
            f"  ► Verbruik per etmaal:\n"
            f"      E = {p_ontlaad:.2f} × 24 = {verbruik_dag:.2f} Wh/dag\n\n"
            f"── DAGBALANS (24 u) ────────────────────────\n"
            f"  Opbrengst (zon)   : +{energie_per_dag:.2f} Wh\n"
            f"  Verbruik          : −{verbruik_dag:.2f} Wh\n"
            f"  ────────────────────────────────\n"
            f"  Netto             : {netto:+.2f} Wh/dag\n\n"
            f"  {conclusie}\n\n"
            f"── CYCLUS-ANALYSE ──────────────────────────\n"
            f"  Duur 1 volledige cyclus : {cyclus_uren:.2f} u "
            f"(laden + ontladen)\n"
            f"  Cycli per etmaal        : {cycli_per_dag:.2f}×\n"
            f"  Uren zon nodig voor vol : {uren_vol:.2f} u\n"
        )
        self._toon_zonne_resultaat(tekst)
        self.status.set(f"Netto dagbalans: {netto:+.2f} Wh/dag "
                        f"(oplaadtijd {formatteer_uren(t_laad_u)}, "
                        f"ontlaadtijd {formatteer_uren(t_ontlaad_u)})")
        log.info(f"Zonne-cyclus: E={wh:.2f}Wh Plaad={p_laad}W "
                 f"Pontlaad={p_ontlaad}W η={rend} zon={zon_uren}u "
                 f"→ t_laad={t_laad_u:.2f}u t_ontlaad={t_ontlaad_u:.2f}u "
                 f"netto={netto:+.2f}Wh/dag")

    def _toon_zonne_resultaat(self, tekst):
        self.zonne_tekst.config(state="normal")
        self.zonne_tekst.delete("1.0", tk.END)
        self.zonne_tekst.insert("1.0", tekst)
        self.zonne_tekst.config(state="disabled")

    # ============================================================
    #  KOPPELING WATT <-> AMPÈRE
    # ============================================================
    def _lees_v0_veilig(self):
        try:
            return float(self.v0_entry.get().replace(",", "."))
        except ValueError:
            return None

    def _on_stroom_edit(self, event=None):
        if self._updating or self._lock_watt.get():
            return
        v = self._lees_v0_veilig()
        if v is None or v <= 0:
            return
        try:
            i = float(self.stroom_entry.get().replace(",", "."))
        except ValueError:
            return
        if i < 0:
            return
        watt = bereken_watt(v, i)
        self._updating = True
        self.watt_entry.delete(0, tk.END)
        self.watt_entry.insert(0, f"{watt:.3f}")
        self._updating = False
        self._update_live_watt(v, i, watt)

    def _on_watt_edit(self, event=None):
        if self._updating or self._lock_amp.get():
            return
        v = self._lees_v0_veilig()
        if v is None or v <= 0:
            return
        try:
            p = float(self.watt_entry.get().replace(",", "."))
        except ValueError:
            return
        if p < 0:
            return
        i = bereken_stroom_ma(v, p)
        self._updating = True
        self.stroom_entry.delete(0, tk.END)
        self.stroom_entry.insert(0, f"{i:.1f}")
        self._updating = False
        self._update_live_watt(v, i, p)

    def _herbereken_koppeling(self, event=None):
        if self._updating:
            return
        v = self._lees_v0_veilig()
        if v is None or v <= 0:
            return
        if self._lock_watt.get():
            self._on_watt_edit()
        elif self._lock_amp.get():
            self._on_stroom_edit()

    def _toggle_lock_watt(self):
        if self._lock_watt.get():
            self._lock_amp.set(False)
            self.status.set("Wattage VAST — Ampère past zich aan bij "
                            "spanningspieken.")
        else:
            self.status.set("Wattage niet meer vast.")

    def _toggle_lock_amp(self):
        if self._lock_amp.get():
            self._lock_watt.set(False)
            self.status.set("Ampère VAST — Watt past zich aan bij "
                            "spanningspieken.")
        else:
            self.status.set("Ampère niet meer vast.")

    def _update_live_watt(self, v, i, watt):
        self.watt_var.set(f"{watt:.3f} W")
        self.watt_detail_var.set(
            f"= {v:.3f} V × {i:.1f} mA ({i/1000:.3f} A)"
        )

    # ------------------------------------------------------------
    def stabiliseer_wattage(self):
        v0 = self._lees_v0_veilig()
        if v0 is None or v0 <= 0:
            messagebox.showerror("Invoerfout", "Ongeldige V₀.")
            return
        try:
            p = float(self.watt_entry.get().replace(",", "."))
        except ValueError:
            messagebox.showerror("Invoerfout", "Ongeldig wattage.")
            return
        if p <= 0:
            messagebox.showerror("Invoerfout", "Wattage moet > 0 zijn.")
            return

        spanningen = [v0, v0 * 0.98, v0 * 0.96, v0 * 0.94, v0 * 0.92]
        regels = [
            "── WATTAGE-STABILISATIE ────────────────────",
            f"Doelvermogen: {p:.3f} W",
            "",
            f"{'Spanning (V)':<15}{'Stroom (mA)':<15}{'Stroom (A)':<12}",
            "-" * 45,
        ]
        max_i = 0.0
        for v in spanningen:
            i = bereken_stroom_ma(v, p)
            max_i = max(max_i, i)
            regels.append(f"{v:<15.3f}{i:<15.1f}{i/1000:<12.3f}")

        regels.append("-" * 45)
        regels.append(f"Maximale stroom bij laagste V: {max_i:.1f} mA "
                      f"({max_i/1000:.3f} A)")
        regels.append("")
        regels.append("Tip: begrens je voeding tot deze maximale stroom ")
        regels.append("     om spanningspieken (en je factuur) te beperken.")
        tekst = "\n".join(regels)
        self._toon_rc_resultaat(tekst)

        self._lock_watt.set(True)
        self._lock_amp.set(False)
        self.status.set(f"Wattage {p:.3f} W gestabiliseerd — "
                        f"max {max_i:.1f} mA bij {spanningen[-1]:.3f} V.")
        log.info(f"Stabilisatie: P={p:.3f}W max I={max_i:.1f}mA")

    # ------------------------------------------------------------
    def _initialiseer_hardware(self):
        if self.weegschaal.beschikbaar:
            if self.weegschaal.init():
                self.hx_status_var.set("✅ Verbonden")
                if not self.weegschaal.laad_kalibratie():
                    self.hx_unit_var.set("— (nog niet gekalibreerd)")
                    self.status.set("Kalibratie nodig — zie HX711-tabblad.")
                else:
                    self.hx_unit_var.set(f"{self.weegschaal.referentie_unit:.4f}")
            else:
                self.hx_status_var.set("❌ Niet gevonden")
                self.status.set("HX711 niet gevonden — DEMO-modus actief.")
        else:
            self.hx_status_var.set("❌ Module niet geïnstalleerd")
            self.status.set("hx711 niet geïnstalleerd — DEMO-modus actief.")

        if self.stroommeter.beschikbaar:
            self.stroommeter.init()

        self._vul_labels_tabel()

    # ============================================================
    #  HX711 TAB-FUNCTIES
    # ============================================================
    def lees_ruwe_waarde(self):
        if self.weegschaal.hx is None:
            self.hx_ruw_var.set("— (DEMO)")
            return
        try:
            waarde = self.weegschaal.hx.get_value(3)
            self.hx_ruw_var.set(f"{waarde}")
        except Exception as e:
            self.hx_ruw_var.set(f"Fout: {e}")

    def _toggle_hx_live(self):
        if self.hx_live.get():
            threading.Thread(target=self._hx_live_lus, daemon=True).start()
            self.status.set("Live HX711-uitlezing gestart.")
        else:
            self.status.set("Live HX711-uitlezing gestopt.")

    def _hx_live_lus(self):
        while self.hx_live.get() and not self.stop_flag.is_set():
            self.root.after(0, self.lees_ruwe_waarde)
            for _ in range(10):
                if not self.hx_live.get() or self.stop_flag.is_set():
                    return
                time.sleep(0.1)

    def herinitialiseer_hx711(self):
        try:
            dout = int(self.dout_entry.get())
            sck  = int(self.sck_entry.get())
        except ValueError:
            messagebox.showerror("Fout", "Pinnen moeten gehele getallen zijn.")
            return
        self.weegschaal = Weegschaal()
        if self.weegschaal.init(dout, sck):
            self.hx_status_var.set("✅ Verbonden (nieuwe pinnen)")
            self.hx_pin_var.set(f"DT=GPIO{dout}, SCK=GPIO{sck}")
            if self.weegschaal.laad_kalibratie():
                self.hx_unit_var.set(f"{self.weegschaal.referentie_unit:.4f}")
            else:
                self.hx_unit_var.set("— (nog niet gekalibreerd)")
            messagebox.showinfo("HX711",
                                f"HX711 geherinitialiseerd op "
                                f"DT=GPIO{dout}, SCK=GPIO{sck}.")
        else:
            self.hx_status_var.set("❌ Herinitialisatie mislukt")
            messagebox.showerror("Fout", "HX711 kon niet geïnitialiseerd worden.")

    # ============================================================
    #  WEGEN
    # ============================================================
    def doe_meting(self):
        gewicht = self.weegschaal.lees()
        if gewicht is None:
            self.status.set("Fout bij lezen gewicht.")
            return
        self.teller += 1
        self.gewicht_var.set(f"{gewicht:.1f} g")

        label, verschil = self._classificeer(gewicht)
        if verschil is not None and label != "Onbekend":
            self.classificatie_var.set(f"{label}  (Δ {verschil:.1f} g)")
        else:
            self.classificatie_var.set(label)

        log_meting(f"gewicht={gewicht}g\tlabel={label}")
        self.status.set(f"Meting #{self.teller} voltooid om "
                        f"{datetime.now().strftime('%H:%M:%S')}")

    def gebruik_handmatig_gewicht(self):
        tekst = self.handmatig_gewicht_entry.get().strip().replace(",", ".")
        if not tekst:
            messagebox.showwarning("Invoer", "Voer een gewicht in gram in.")
            return
        try:
            gewicht = float(tekst)
        except ValueError:
            messagebox.showerror("Fout", f"'{tekst}' is geen geldig getal.")
            return
        if gewicht < 0:
            messagebox.showerror("Fout", "Gewicht kan niet negatief zijn.")
            return

        self.teller += 1
        self.gewicht_var.set(f"{gewicht:.1f} g")
        self.status.set(f"Handmatige waarde overgenomen: {gewicht:.1f} g")
        log.info(f"Handmatige gewichtsinvoer: {gewicht} g")

    def classificeer_handmatig(self):
        tekst = self.handmatig_gewicht_entry.get().strip().replace(",", ".")
        if not tekst:
            messagebox.showwarning("Invoer", "Voer eerst een gewicht in.")
            return
        try:
            gewicht = float(tekst)
        except ValueError:
            messagebox.showerror("Fout", f"'{tekst}' is geen geldig getal.")
            return

        self.gewicht_var.set(f"{gewicht:.1f} g")
        label, verschil = self._classificeer(gewicht)
        if verschil is not None and label != "Onbekend":
            self.classificatie_var.set(f"{label}  (Δ {verschil:.1f} g)")
        else:
            self.classificatie_var.set(label)

        log_meting(f"handmatig={gewicht}g\tlabel={label}")
        self.status.set(f"Handmatige classificatie: {label}")

    def kalibreer_vanuit_gui(self):
        if self.weegschaal.hx is None:
            messagebox.showwarning("Kalibratie",
                                   "Geen HX711 beschikbaar (DEMO-modus).")
            return
        tekst = self.kalibratie_entry.get().strip().replace(",", ".")
        if not tekst:
            messagebox.showwarning("Kalibratie",
                                   "Voer een bekend gewicht in gram in.")
            return
        try:
            bekend = float(tekst)
        except ValueError:
            messagebox.showerror("Fout", f"'{tekst}' is geen geldig getal.")
            return
        if bekend <= 0:
            messagebox.showerror("Fout", "Gewicht moet groter dan 0 zijn.")
            return

        if self.weegschaal.kalibreer(bekend):
            self.hx_unit_var.set(f"{self.weegschaal.referentie_unit:.4f}")
            messagebox.showinfo("Kalibratie",
                                f"Kalibratie voltooid met {bekend} g.\n"
                                f"Referentie-unit: "
                                f"{self.weegschaal.referentie_unit:.4f}")
            self.status.set(f"Gekalibreerd op {bekend} g.")
        else:
            messagebox.showerror("Fout",
                                 "Kalibratie mislukt. Controleer bedrading.")

    def _classificeer(self, gewicht):
        if not self.labels or gewicht is None:
            return "Onbekend", None
        beste_label    = "Onbekend"
        beste_verschil = float("inf")
        for label, waarde in self.labels.items():
            verschil = abs(gewicht - waarde)
            if verschil < beste_verschil:
                beste_verschil = verschil
                beste_label    = label
        if beste_verschil <= CONFIG["tolerantie_gram"]:
            return beste_label, beste_verschil
        return "Onbekend", beste_verschil

    def tarreer(self):
        if self.weegschaal.hx is None:
            self.status.set("Tarreer niet mogelijk (DEMO-modus).")
            return
        if self.weegschaal.tarreer():
            self.status.set("Weegschaal op nul gezet.")
        else:
            self.status.set("Tarreerfout.")

    def _toggle_auto(self):
        if self.automatisch.get():
            self.stop_flag.clear()
            threading.Thread(target=self._auto_lus, daemon=True).start()
            self.status.set("Automatisch meten gestart.")
        else:
            self.stop_flag.set()
            self.status.set("Automatisch meten gestopt.")

    def _auto_lus(self):
        while not self.stop_flag.is_set() and self.automatisch.get():
            self.root.after(0, self.doe_meting)
            for _ in range(CONFIG["wacht_tussen_meten"] * 10):
                if self.stop_flag.is_set() or not self.automatisch.get():
                    return
                time.sleep(0.1)

    # ============================================================
    #  LABELS
    # ============================================================
    def sla_nieuw_label_op(self):
        naam = self.nieuw_label_entry.get().strip()
        if not naam:
            messagebox.showwarning("Naam", "Voer een naam in.")
            return
        try:
            gewicht = float(self.gewicht_var.get().replace(" g", "")
                            .replace(",", ".").strip())
        except ValueError:
            messagebox.showwarning("Gewicht",
                                   "Voer eerst een geldige meting uit.")
            return
        self.labels[naam] = gewicht
        sla_json_atomisch_op(LABELS_FILE, self.labels)
        self.nieuw_label_entry.delete(0, tk.END)
        self._vul_labels_tabel()
        self.status.set(f"Label '{naam}' opgeslagen ({gewicht} g).")

    def _vul_labels_tabel(self):
        for item in self.labels_tree.get_children():
            self.labels_tree.delete(item)
        for naam, waarde in self.labels.items():
            self.labels_tree.insert("", "end",
                                    values=(naam, f"{waarde:.1f}", "—"))

    def verwijder_label(self):
        selectie = self.labels_tree.selection()
        if not selectie:
            return
        for item in selectie:
            naam = self.labels_tree.item(item)["values"][0]
            self.labels.pop(naam, None)
        sla_json_atomisch_op(LABELS_FILE, self.labels)
        self._vul_labels_tabel()
        self.status.set("Label(s) verwijderd.")

    # ============================================================
    #  BATTERIJ / WATT / RC
    # ============================================================
    def _toggle_ina(self):
        if self.gebruik_ina.get() and not self.stroommeter.beschikbaar:
            messagebox.showwarning(
                "INA219",
                "INA219 niet beschikbaar.\nInstalleer: pip3 install pi-ina219"
            )
            self.gebruik_ina.set(False)

    def _lees_v_en_i(self):
        try:
            if self.gebruik_ina.get():
                v, i = self.stroommeter.lees()
                if v is None:
                    raise ValueError("INA219 gaf geen waarde.")
                self.stroom_entry.delete(0, tk.END)
                self.stroom_entry.insert(0, f"{i:.1f}")
                p = bereken_watt(v, i)
                self.watt_entry.delete(0, tk.END)
                self.watt_entry.insert(0, f"{p:.3f}")
                return v, i
            v = float(self.v0_entry.get().replace(",", "."))
            i = float(self.stroom_entry.get().replace(",", "."))
            return v, i
        except ValueError as e:
            messagebox.showerror("Invoerfout", f"Ongeldige waarde: {e}")
            return None, None

    def bereken_watt_knop(self):
        v, i = self._lees_v_en_i()
        if v is None:
            return
        if v <= 0 or i <= 0:
            messagebox.showerror("Invoerfout",
                                 "Spanning en stroom moeten > 0 zijn.")
            return

        watt = bereken_watt(v, i)
        self._update_live_watt(v, i, watt)
        self.watt_entry.delete(0, tk.END)
        self.watt_entry.insert(0, f"{watt:.3f}")
        self.status.set(f"Actueel verbruik: {watt:.3f} W")
        log.info(f"Watt: P = {v:.3f} V × {i:.1f} mA = {watt:.3f} W")

    def bereken_batterij(self):
        v, i = self._lees_v_en_i()
        if v is None:
            return
        try:
            v0   = float(self.v0_entry.get().replace(",", "."))
            vmin = float(self.vmin_entry.get().replace(",", "."))
            cap  = float(self.cap_entry.get().replace(",", "."))
            stroom_ma = i
        except ValueError as e:
            messagebox.showerror("Invoerfout", f"Ongeldige waarde: {e}")
            return

        if v0 <= 0 or vmin <= 0 or cap <= 0 or stroom_ma <= 0:
            messagebox.showerror("Invoerfout", "Alle waarden moeten > 0 zijn.")
            return
        if vmin >= v0:
            messagebox.showerror("Invoerfout",
                                 "V_min moet kleiner zijn dan V₀.")
            return

        watt = bereken_watt(v0, stroom_ma)
        self._update_live_watt(v0, stroom_ma, watt)
        self.watt_entry.delete(0, tk.END)
        self.watt_entry.insert(0, f"{watt:.3f}")

        rc = bereken_rc(v0, stroom_ma, cap)
        if rc is None:
            messagebox.showerror("Fout", "RC-berekening mislukt.")
            return

        t_sec = resterende_tijd_seconden(v0, vmin, rc["tau"])
        wh    = mah_naar_wh(cap, v0)

        tekst = (
            f"── INVOER ─────────────────────────────────\n"
            f"  Startspanning V₀     : {v0:.3f} V\n"
            f"  Drempelspanning V_min: {vmin:.3f} V\n"
            f"  Capaciteit           : {cap:.0f} mAh "
            f"({wh:.2f} Wh)\n"
            f"  Stroom               : {stroom_ma:.1f} mA "
            f"({stroom_ma/1000:.3f} A)\n\n"
            f"── VERMOGEN (P = V × I) ───────────────────\n"
            f"  P = {v0:.3f} × {stroom_ma/1000:.3f}\n"
            f"    = {watt:.3f} W   ({watt*1000:.1f} mW)\n\n"
            f"── RC-FORMULE ─────────────────────────────\n"
            f"  R  = V / I           = {rc['R']:.2f} Ω\n"
            f"  C  = (mAh × 3.6) / V = {rc['C']:.2f} F\n"
            f"  τ  = R · C           = {rc['tau']:.2f} s "
            f"({rc['tau']/3600:.3f} u)\n\n"
            f"── RESTERENDE TIJD ────────────────────────\n"
            f"  t = −τ · ln(V_min / V₀) = {t_sec:.2f} s\n"
            f"  ► Resterende tijd: {formatteer_tijd(t_sec)}\n"
            f"  ► Dat is {t_sec/3600:.2f} uur "
            f"({t_sec/60:.1f} minuten)\n"
            f"  ► Verbruik: {watt:.3f} W\n"
        )
        self._toon_rc_resultaat(tekst)
        log.info(f"RC: V0={v0} Vmin={vmin} cap={cap} "
                 f"I={stroom_ma}mA P={watt:.3f}W → t={t_sec:.1f}s")

    def _toon_rc_resultaat(self, tekst):
        self.rc_tekst.config(state="normal")
        self.rc_tekst.delete("1.0", tk.END)
        self.rc_tekst.insert("1.0", tekst)
        self.rc_tekst.config(state="disabled")

    # ------------------------------------------------------------
    def _bij_sluiten(self):
        self.stop_flag.set()
        self.hx_live.set(False)
        self.automatisch.set(False)
        self.root.destroy()

# ================================================================
#  ENTRY POINT
# ================================================================
def main():
    log.info("=" * 60)
    log.info("BATTERY WEEGSCHAAL GUI gestart (met zonne-cyclus)")
    log.info("=" * 60)

    root = tk.Tk()
    app = WeegschaalGUI(root)

    def _stop(signum, frame):
        log.info("Stop-signaal ontvangen.")
        root.after(0, app._bij_sluiten)

    signal.signal(signal.SIGINT,  _stop)
    signal.signal(signal.SIGTERM, _stop)

    root.mainloop()
    log.info("Programma netjes afgesloten.")

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        log.exception(f"Onverwachte fout: {e}")
        sys.exit(1)
