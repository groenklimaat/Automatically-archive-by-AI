        ttk.Button(source_btn_frame, text="❌ Verwijder", command=self._remove_source, width=10).pack(pady=1)
        
        # Doelmap
        ttk.Label(cfg, text="📀 Archiefmap (doel):").grid(row=2, column=0, sticky=W, pady=(10, 2))
        self.archive_entry = ttk.Entry(cfg)
        self.archive_entry.grid(row=2, column=1, sticky=(W, E), padx=5, pady=(10, 2))
        ttk.Button(cfg, text="Bladeren", command=self._select_archive).grid(row=2, column=2, pady=(10, 2))
        
        # Sorteeropties (automatisch aan)
        sort_frame = ttk.LabelFrame(cfg, text="📂 Automatische Sortering", padding="5")
        sort_frame.grid(row=3, column=0, columnspan=3, sticky=W, pady=(10, 0))
        
        self.category_var = BooleanVar(value=True)
        ttk.Checkbutton(sort_frame, text="✅ Op Categorie (Documenten, Afbeeldingen, etc.)", 
                       variable=self.category_var).pack(anchor=W)
        
        self.date_var = BooleanVar(value=True)
        ttk.Checkbutton(sort_frame, text="✅ Op Datum (Jaar/Maand)", 
                       variable=self.date_var).pack(anchor=W)
        
        self.type_var = BooleanVar(value=False)
        ttk.Checkbutton(sort_frame, text="Op Bestandstype", 
                       variable=self.type_var).pack(anchor=W)
        
        # Veiligheidsopties
        safety_frame = ttk.LabelFrame(cfg, text="🔒 Veiligheidsinstellingen", padding="5")
        safety_frame.grid(row=4, column=0, columnspan=3, sticky=W, pady=(10, 0))
        
        self.hidden_var = BooleanVar(value=False)
        ttk.Checkbutton(safety_frame, text="👁️ Verborgen bestanden meenemen", 
                       variable=self.hidden_var).pack(anchor=W)
        
        self.duplicates_var = BooleanVar(value=True)
        ttk.Checkbutton(safety_frame, text="🔄 Duplicaten detecteren en hernoemen", 
                       variable=self.duplicates_var).pack(anchor=W)
        
        # ⚠️ CRUCIAAL: Verwijderen standaard UIT - met duidelijke waarschuwing
        delete_frame = ttk.Frame(safety_frame)
        delete_frame.pack(anchor=W, pady=(5, 0))
        
        self.delete_orig_var = BooleanVar(value=False)  # Standaard UIT!
        delete_check = ttk.Checkbutton(delete_frame, text="⚠️ VERWIJDER ORIGINELE BESTANDEN", 
                                       variable=self.delete_orig_var)
        delete_check.pack(side=LEFT)
        
        ttk.Label(delete_frame, text="(Standaard UIT - alleen aanzetten als je zeker weet wat je doet!)", 
                 foreground="red", font=("Arial", 8)).pack(side=LEFT, padx=5)
        
        # Status
        self.status_label = ttk.Label(cfg, text="🟢 Klaar - Veilige modus actief", foreground="green")
        self.status_label.grid(row=5, column=0, columnspan=3, sticky=W, pady=(10, 0))
        
        # Knoppen
        btn_frame = ttk.Frame(main)
        btn_frame.grid(row=2, column=0, pady=10)
        
        self.start_btn = ttk.Button(btn_frame, text="▶ Start Sorteren", command=self._start_archive)
        self.start_btn.grid(row=0, column=0, padx=5)
        
        self.stop_btn = ttk.Button(btn_frame, text="⏹ Stop", command=self._stop_archive, state=DISABLED)
        self.stop_btn.grid(row=0, column=1, padx=5)
        
        ttk.Button(btn_frame, text="💾 Opslaan", command=self._save_settings).grid(row=0, column=2, padx=5)
        ttk.Button(btn_frame, text="📊 Stats", command=self._show_stats).grid(row=0, column=3, padx=5)
        ttk.Button(btn_frame, text="🧹 Clear", command=self._clear_log).grid(row=0, column=4, padx=5)
        
        # Logboek
        log_frame = ttk.LabelFrame(main, text="📋 Logboek", padding="5")
        log_frame.grid(row=3, column=0, sticky=(N, W, E, S), pady=10)
        log_frame.columnconfigure(0, weight=1)
        log_frame.rowconfigure(1, weight=1)
        
        log_controls = ttk.Frame(log_frame)
        log_controls.grid(row=0, column=0, sticky=W, pady=(0, 5))
        ttk.Button(log_controls, text="🗑 Wissen", command=self._clear_log).pack(side=LEFT, padx=2)
        ttk.Button(log_controls, text="📋 Kopieer", command=self._copy_log).pack(side=LEFT, padx=2)
        
        self.safety_indicator = ttk.Label(log_controls, text="🔒 Veilig - Kopiëren (geen verwijdering)", 
                                         foreground="green")
        self.safety_indicator.pack(side=LEFT, padx=10)
        
        self.status_display = ttk.Label(log_controls, text="📊 Status: Wachtend", foreground="blue")
        self.status_display.pack(side=LEFT, padx=10)
        
        self.log_text = scrolledtext.ScrolledText(log_frame, height=20, font=("Courier", 9))
        self.log_text.grid(row=1, column=0, sticky=(N, W, E, S))
        
        # Tags voor kleurcodering
        self.log_text.tag_configure("success", foreground="green")
        self.log_text.tag_configure("error", foreground="red")
        self.log_text.tag_configure("warning", foreground="orange")
        self.log_text.tag_configure("info", foreground="blue")
        self.log_text.tag_configure("category", foreground="darkgreen")
        self.log_text.tag_configure("safety", foreground="green")
    
    def _log(self, msg, tag=None):
        timestamp = datetime.now().strftime("%H:%M:%S")
        formatted = f"[{timestamp}] {msg}\n"
        
        if tag:
            self.log_text.insert(END, formatted, tag)
        else:
            if "✅" in msg:
                self.log_text.insert(END, formatted, "success")
            elif "❌" in msg:
                self.log_text.insert(END, formatted, "error")
            elif "⚠️" in msg:
                self.log_text.insert(END, formatted, "warning")
            elif "🔒" in msg:
                self.log_text.insert(END, formatted, "safety")
            elif any(cat in msg for cat in ["Documenten", "Afbeeldingen", "Video", "Muziek"]):
                self.log_text.insert(END, formatted, "category")
            else:
                self.log_text.insert(END, formatted, "info")
        
        self.log_text.see(END)
        self.root.update()
    
    def _clear_log(self):
        self.log_text.delete(1.0, END)
    
    def _copy_log(self):
        self.root.clipboard_clear()
        self.root.clipboard_append(self.log_text.get(1.0, END))
        self._log("📋 Gekopieerd", "info")
    
    def _add_source(self):
        folder = filedialog.askdirectory(title="Selecteer bronmap om te sorteren")
        if folder:
            self.source_listbox.insert(END, folder)
            self._log(f"➕ Bronmap toegevoegd: {folder}", "info")
    
    def _add_home(self):
        home = str(Path.home())
        self.source_listbox.insert(END, home)
        self._log(f"🏠 Home map toegevoegd: {home}", "info")
    
    def _remove_source(self):
        selected = self.source_listbox.curselection()
        if selected:
            for i in reversed(selected):
                folder = self.source_listbox.get(i)
                self.source_listbox.delete(i)
                self._log(f"❌ Bronmap verwijderd: {folder}", "warning")
    
    def _select_archive(self):
        folder = filedialog.askdirectory(title="Selecteer archiefmap (doelmap voor gesorteerde bestanden)")
        if folder:
            self.archive_entry.delete(0, END)
            self.archive_entry.insert(0, folder)
            self._log(f"📁 Archiefmap: {folder}", "info")
    
    def _start_archive(self):
        # Controleer of verwijderen is aangevinkt - extra veiligheidswaarschuwing
        if self.delete_orig_var.get():
            confirm = messagebox.askyesno(
                "⚠️ WAARSCHUWING - Bestanden verwijderen",
                "Je hebt aangevinkt dat originele bestanden VERWIJDERD mogen worden.\n\n"
                "Dit kan niet ongedaan worden gemaakt!\n\n"
                "Weet je zeker dat je de originele bestanden wilt verwijderen?\n"
                "(Klik NEE om veilig te kopiëren zonder verwijdering)",
                icon='warning'
            )
            if not confirm:
                self.delete_orig_var.set(False)
                self._log("🔒 Verwijderen uitgeschakeld (veilige modus)", "safety")
                messagebox.showinfo("🔒 Veilige modus", 
                                   "Originele bestanden worden NIET verwijderd.\n"
                                   "Ze worden alleen gekopieerd naar de archiefmap.")
                return
        
        if not self._validate():
            return
        
        self._update_settings()
        self.archiver = Archiver(self.settings)
        self.running = True
        
        self.start_btn.config(state=DISABLED)
        self.stop_btn.config(state=NORMAL)
        
        if self.settings.delete_original:
            self.status_label.config(text="⚠️ VERWIJDEREN INGESCHAKELD - Wees voorzichtig!", foreground="red")
            self.safety_indicator.config(text="⚠️ Verwijderen AAN", foreground="red")
        else:
            self.status_label.config(text="🟢 Bezig met kopiëren (veilig)...", foreground="green")
            self.safety_indicator.config(text="🔒 Veilig - Kopiëren (geen verwijdering)", foreground="green")
        
        self.status_display.config(text="📊 Bezig met sorteren...")
        self._log("🚀 Sorteren gestart!", "success")
        self._log(f"🔒 Verwijderen: {'AAN' if self.settings.delete_original else 'UIT (veilig)'}", "safety")
        
        thread = threading.Thread(target=self._archive_thread, daemon=True)
        thread.start()
    
    def _archive_thread(self):
        try:
            self.archiver.archive_all(self._log)
            self.root.after(0, self._archive_complete)
        except Exception as e:
            self.root.after(0, lambda: self._log(f"❌ Fout: {e}", "error"))
            self.root.after(0, self._archive_complete)
    
    def _archive_complete(self):
        self.running = False
        self.start_btn.config(state=NORMAL)
        self.stop_btn.config(state=DISABLED)
        
        if self.settings.delete_original:
            self.status_label.config(text="✅ Voltooid - Bestanden VERWIJDERD", foreground="red")
        else:
            self.status_label.config(text="✅ Voltooid - Bestanden gekopieerd (veilig)", foreground="green")
            self.safety_indicator.config(text="🔒 Veilig - Kopiëren (geen verwijdering)", foreground="green")
        
        self.status_display.config(text="✅ Voltooid")
        self._update_status()
    
    def _stop_archive(self):
        self.running = False
        self.start_btn.config(state=NORMAL)
        self.stop_btn.config(state=DISABLED)
        self.status_label.config(text="🔴 Gestopt", foreground="red")
        self.status_display.config(text="🔴 Gestopt")
        self._log("🛑 Gestopt", "warning")
    
    def _update_status(self):
        if self.archiver:
            stats = self.archiver.stats
            self.status_display.config(text=f"📊 Gescand: {stats['total_scanned']} | Gearchiveerd: {stats['archived']}")
    
    def _validate(self) -> bool:
        sources = list(self.source_listbox.get(0, END))
        if not sources:
            messagebox.showwarning("Waarschuwing", "Voeg minstens één bronmap toe")
            return False
        
        archive = self.archive_entry.get().strip()
        if not archive:
            messagebox.showwarning("Waarschuwing", "Selecteer een archiefmap")
            return False
        
        if not Path(archive).exists():
            try:
                Path(archive).mkdir(parents=True, exist_ok=True)
                self._log(f"📁 Archiefmap aangemaakt: {archive}", "info")
            except:
                messagebox.showerror("Fout", f"Kan map niet aanmaken: {archive}")
                return False
        
        return True
    
    def _update_settings(self):
        self.settings.source_folders = list(self.source_listbox.get(0, END))
        self.settings.archive_folder = self.archive_entry.get().strip()
        self.settings.organize_by_category = self.category_var.get()
        self.settings.organize_by_date = self.date_var.get()
        self.settings.organize_by_type = self.type_var.get()
        self.settings.include_hidden = self.hidden_var.get()
        self.settings.detect_duplicates = self.duplicates_var.get()
        self.settings.delete_original = self.delete_orig_var.get()  # Alleen als expliciet aangevinkt
        self.settings.max_workers = multiprocessing.cpu_count()
    
    def _show_stats(self):
        if self.archiver:
            stats = self.archiver.stats
            msg = f"""📊 SORTERING STATISTIEKEN
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  Platform:     {platform.system()}
  Gescand:      {stats['total_scanned']}
  Gearchiveerd: {stats['archived']}
  Duplicaten:   {stats['duplicates']}
  Fouten:       {stats['errors']}
  
  Totaal:       {stats['total_size_mb'] / 1024:.2f} GB
  Gearchiveerd: {stats['archived_size_mb'] / 1024:.2f} GB
  
  🔒 Verwijderd: {'JA' if self.settings.delete_original else 'NEE (veilig)'}
  
  ⏱️ Tijd: {stats['elapsed_seconds']:.0f} seconden"""
            
            if stats['categories']:
                msg += "\n\n📂 CATEGORIEËN (gesorteerd):"
                for cat, count in sorted(stats['categories'].items(), key=lambda x: x[1], reverse=True)[:10]:
                    msg += f"\n  {cat}: {count} bestanden"
            
            messagebox.showinfo("Sorteer Statistieken", msg)
        else:
            messagebox.showinfo("Statistieken", "Nog geen sortering uitgevoerd")
    
    def _save_settings(self):
        settings = {
            'source_folders': list(self.source_listbox.get(0, END)),
            'archive_folder': self.archive_entry.get().strip(),
            'organize_by_category': self.category_var.get(),
            'organize_by_date': self.date_var.get(),
            'organize_by_type': self.type_var.get(),
            'include_hidden': self.hidden_var.get(),
            'detect_duplicates': self.duplicates_var.get(),
            'delete_original': self.delete_orig_var.get()
        }
        try:
            with open(self.settings_file, 'w') as f:
                json.dump(settings, f, indent=2)
            self._log("💾 Instellingen opgeslagen", "success")
        except Exception as e:
            self._log(f"❌ Opslaan mislukt: {e}", "error")
    
    def _load_settings(self):
        try:
            if self.settings_file.exists():
                with open(self.settings_file, 'r') as f:
                    s = json.load(f)
                
                for folder in s.get('source_folders', []):
                    self.source_listbox.insert(END, folder)
                self.archive_entry.insert(0, s.get('archive_folder', ''))
                self.category_var.set(s.get('organize_by_category', True))
                self.date_var.set(s.get('organize_by_date', True))
                self.type_var.set(s.get('organize_by_type', False))
                self.hidden_var.set(s.get('include_hidden', False))
                self.duplicates_var.set(s.get('detect_duplicates', True))
                self.delete_orig_var.set(s.get('delete_original', False))
                self._log("📂 Instellingen geladen", "info")
        except Exception as e:
            self._log(f"⚠️ Laden mislukt: {e}", "warning")


