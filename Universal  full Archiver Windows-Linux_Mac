# ARCHIVER - VEILIG (GEEN AUTOMATISCH VERWIJDEREN)
# ============================================================================

class Archiver:
    def __init__(self, settings: ArchiveSettings):
        self.settings = settings
        self.analyzer = FileAnalyzer()
        self.archive_path = Path(settings.archive_folder)
        
        self.stats = {
            'total_scanned': 0,
            'total_size_mb': 0,
            'archived': 0,
            'archived_size_mb': 0,
            'duplicates': 0,
            'errors': 0,
            'skipped': 0,
            'categories': {},
            'extensions': {},
            'error_details': [],
            'start_time': None,
            'end_time': None,
            'elapsed_seconds': 0
        }
        
        self.processed_checksums: Set[str] = set()

    def scan_folder(self, folder_path: Path, log_callback=None) -> List[Path]:
        files = []
        if not folder_path.exists():
            if log_callback:
                log_callback(f"❌ Map bestaat niet: {folder_path}")
            return files
        
        try:
            for root, dirs, filenames in os.walk(folder_path):
                current_depth = len(Path(root).relative_to(folder_path).parts)
                if self.settings.max_depth > 0 and current_depth >= self.settings.max_depth:
                    dirs.clear()
                    continue
                
                if not self.settings.include_hidden:
                    dirs[:] = [d for d in dirs if not d.startswith('.')]
                
                for filename in filenames:
                    filepath = Path(root) / filename
                    
                    if not self.settings.include_hidden and filename.startswith('.'):
                        continue
                    
                    if not self.settings.include_system:
                        if self.analyzer._is_system_file(filepath):
                            continue
                    
                    try:
                        size = filepath.stat().st_size
                        if size > self.settings.max_size_mb * 1024 * 1024:
                            continue
                    except:
                        continue
                    
                    files.append(filepath)
        except Exception as e:
            if log_callback:
                log_callback(f"⚠️ Fout bij scannen: {e}")
        
        return files

    def process_file(self, filepath: Path, log_callback=None) -> bool:
        try:
            file_info = self.analyzer.analyze_file(filepath)
            if not file_info:
                self.stats['skipped'] += 1
                return False
            
            self.stats['total_scanned'] += 1
            self.stats['total_size_mb'] += file_info['size_mb']
            
            category_name = file_info['category'].value
            self.stats['categories'][category_name] = self.stats['categories'].get(category_name, 0) + 1
            
            ext = file_info['extension'] or "Geen_extensie"
            self.stats['extensions'][ext] = self.stats['extensions'].get(ext, 0) + 1
            
            # Duplicaat detectie - hernoemen ipv verwijderen
            if self.settings.detect_duplicates and file_info['checksum']:
                checksum = file_info['checksum']
                if checksum in self.processed_checksums:
                    self.stats['duplicates'] += 1
                    if self.settings.duplicate_action == "skip":
                        return False
                    # Bij "rename" wordt het bestand later hernoemd
                else:
                    self.processed_checksums.add(checksum)
            
            # Bepaal doelpad (automatische sortering)
            dest_path = self._determine_destination(file_info)
            dest_path.parent.mkdir(parents=True, exist_ok=True)
            
            # Als bestand al bestaat, voeg timestamp toe (veilig hernoemen)
            if dest_path.exists():
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                dest_path = dest_path.parent / f"{dest_path.stem}_{timestamp}{dest_path.suffix}"
                if log_callback:
                    log_callback(f"📝 Bestand hernoemd (duplicaat): {file_info['name']} -> {dest_path.name}")
            
            if self.settings.dry_run:
                if log_callback:
                    log_callback(f"🔍 [DRY RUN] {filepath.name} -> {dest_path}")
                self.stats['archived'] += 1
                self.stats['archived_size_mb'] += file_info['size_mb']
                return True
            
            # KOPIEER het bestand (origineel blijft staan)
            try:
                shutil.copy2(str(filepath), str(dest_path))
                
                # ⚠️ ALLEEN VERWIJDEREN ALS EXPLICIET TOEGESTAAN
                if self.settings.delete_original:
                    if log_callback:
                        log_callback(f"🗑️ Origineel verwijderd (toegestaan): {filepath.name}")
                    os.remove(filepath)
                else:
                    if log_callback:
                        log_callback(f"✅ Gekopieerd (origineel behouden): {filepath.name} -> {dest_path}")
                    
            except Exception as e:
                if log_callback:
                    log_callback(f"⚠️ Fout bij kopiëren: {filepath.name} - {e}")
                self.stats['errors'] += 1
                self.stats['error_details'].append(f"{filepath.name}: {e}")
                return False
            
            self.stats['archived'] += 1
            self.stats['archived_size_mb'] += file_info['size_mb']
            return True
            
        except Exception as e:
            error_msg = f"❌ Fout bij {filepath.name}: {str(e)}"
            self.stats['errors'] += 1
            self.stats['error_details'].append(error_msg)
            if log_callback:
                log_callback(error_msg)
            return False

    def _determine_destination(self, file_info: Dict) -> Path:
        """Automatisch de juiste map bepalen op basis van categorie en datum"""
        base = self.archive_path
        
        # ✅ AUTOMATISCH SORTEREN OP CATEGORIE
        if self.settings.organize_by_category:
            base = base / file_info['category'].value
        
        # ✅ AUTOMATISCH SORTEREN OP TYPE
        if self.settings.organize_by_type:
            file_type = file_info['extension'][1:].upper() if file_info['extension'] else "Onbekend"
            if file_type != "Geen_extensie":
                base = base / file_type
        
        # ✅ AUTOMATISCH SORTEREN OP DATUM
        if self.settings.organize_by_date:
            modified = file_info['modified']
            base = base / str(modified.year) / f"{modified.month:02d}"
        
        return base / file_info['name']

    def archive_all(self, log_callback=None) -> bool:
        self.stats['start_time'] = datetime.now()
        
        if log_callback:
            log_callback("=" * 70)
            log_callback("🚀 UNIVERSELE BESTANDSARCHIVER - VEILIGE MODUS")
            log_callback("=" * 70)
            log_callback(f"📅 Start: {self.stats['start_time'].strftime('%Y-%m-%d %H:%M:%S')}")
            log_callback(f"💻 Platform: {platform.system()}")
            log_callback(f"👤 Gebruiker: {getpass.getuser()}")
            log_callback(f"🔒 Verwijderen: {'AAN' if self.settings.delete_original else 'UIT (veilig)'}")
            log_callback("=" * 70)
        
        all_files = []
        for folder in self.settings.source_folders:
            folder_path = Path(folder)
            if not folder_path.exists():
                if log_callback:
                    log_callback(f"⚠️ Bronmap bestaat niet: {folder}")
                continue
            files = self.scan_folder(folder_path, log_callback)
            all_files.extend(files)
            if log_callback:
                log_callback(f"📊 {folder}: {len(files)} bestanden gevonden")
        
        if not all_files:
            if log_callback:
                log_callback("📭 Geen bestanden gevonden")
            return False
        
        if log_callback:
            total_size_gb = sum(f.stat().st_size for f in all_files) / (1024 ** 3)
            log_callback(f"\n📦 {len(all_files)} bestanden gevonden")
            log_callback(f"📊 Totaal grootte: {total_size_gb:.2f} GB")
            log_callback(f"📂 Automatische sortering: Categorieën + Datum")
            log_callback("🔍 Bestanden kopiëren...")
            log_callback("=" * 70)
        
        processed = 0
        if self.settings.use_multithreading:
            with ThreadPoolExecutor(max_workers=self.settings.max_workers) as executor:
                futures = []
                for filepath in all_files:
                    future = executor.submit(self.process_file, filepath, log_callback)
                    futures.append(future)
                
                for future in as_completed(futures):
                    processed += 1
                    if log_callback and processed % 100 == 0:
                        log_callback(f"✅ {processed} bestanden verwerkt...")
        else:
            for filepath in all_files:
                self.process_file(filepath, log_callback)
                processed += 1
                if log_callback and processed % 100 == 0:
                    log_callback(f"✅ {processed} bestanden verwerkt...")
        
        self.stats['end_time'] = datetime.now()
        self.stats['elapsed_seconds'] = (self.stats['end_time'] - self.stats['start_time']).total_seconds()
        
        if log_callback:
            log_callback("\n" + "=" * 70)
            log_callback("✨ ARCHIVERING VOLTOOID!")
            log_callback("=" * 70)
            log_callback(f"📁 Gescand: {self.stats['total_scanned']}")
            log_callback(f"✅ Gearchiveerd: {self.stats['archived']}")
            log_callback(f"🔄 Duplicaten: {self.stats['duplicates']}")
            log_callback(f"⏭️ Overgeslagen: {self.stats['skipped']}")
            log_callback(f"❌ Fouten: {self.stats['errors']}")
            log_callback(f"📊 Totaal: {self.stats['total_size_mb'] / 1024:.2f} GB")
            log_callback(f"📊 Gearchiveerd: {self.stats['archived_size_mb'] / 1024:.2f} GB")
            log_callback(f"🔒 Originele bestanden: {'VERWIJDERD' if self.settings.delete_original else 'BEWAARD (veilig)'}")
            
            hours = int(self.stats['elapsed_seconds'] // 3600)
            minutes = int((self.stats['elapsed_seconds'] % 3600) // 60)
            seconds = int(self.stats['elapsed_seconds'] % 60)
            log_callback(f"⏱️ Tijd: {hours:02d}:{minutes:02d}:{seconds:02d}")
            
            if self.stats['categories']:
                log_callback("\n📂 CATEGORIEËN (automatisch gesorteerd):")
                for cat, count in sorted(self.stats['categories'].items(), key=lambda x: x[1], reverse=True)[:10]:
                    log_callback(f"  {cat}: {count} bestanden")
        
        return True


