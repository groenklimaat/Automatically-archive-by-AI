def main():
    root = Tk()
    app = ArchiverApp(root)
    
    def on_closing():
        if app.running:
            app._stop_archive()
        root.destroy()
    
    root.protocol("WM_DELETE_WINDOW", on_closing)
    root.mainloop()

if __name__ == "__main__":
    main()
